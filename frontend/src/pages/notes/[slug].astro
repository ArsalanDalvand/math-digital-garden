---
import Reader from '../../layouts/Reader.astro';
import WorkspaceNote from '../../components/WorkspaceNote.astro';
import CanonicalActions from '../../components/CanonicalActions.astro';
import GeoGebra from '../../components/GeoGebra.astro';
import { getKnowledgeIndex } from '../../lib/catalogue.mjs';
import { renderSingleNote, type RenderedNote } from '../../lib/markdown.mjs';
import Connections from '../../components/Connections.astro';
import NoteGraph from '../../components/NoteGraph.astro';
import InlinePreviews from '../../components/InlinePreviews.astro';
import NoteProperties from '../../components/NoteProperties.astro';
import SemanticConnections from '../../components/SemanticConnections.astro';
import NotePager from '../../components/NotePager.astro';
import { folderTree } from '../../lib/folder-tree.mjs';
import { findNoteNeighbors } from '../../lib/note-pager.mjs';

let bySlug: Awaited<ReturnType<typeof getKnowledgeIndex>>['bySlug'] = new Map();
let current: RenderedNote | undefined;
let neighbors: ReturnType<typeof findNoteNeighbors> | null = null;
const slug = Astro.params.slug ?? '';
let title = 'یادداشت در دسترس نیست';
let html = '';
let aiHash = '';
let message = '';
if (!/^[\p{L}\p{N}_-]{1,255}$/u.test(slug)) {
  Astro.response.status = 404;
  message = 'یادداشت پیدا نشد.';
} else {
  try {
    const origin = process.env.API_BASE_URL || import.meta.env.API_BASE_URL || 'http://127.0.0.1:8000';
    const response = await fetch(`${origin}/api/notes/${encodeURIComponent(slug)}`, {
      signal: AbortSignal.timeout(5000),
    });
    if (response.status === 404 || response.status === 422) {
      Astro.response.status = 404;
      message = 'یادداشت پیدا نشد.';
    } else if (!response.ok) {
      Astro.response.status = 503;
      message = 'دریافت یادداشت موقتاً امکان‌پذیر نیست. دوباره تلاش کنید.';
    } else {
      const note = await response.json();
      if (typeof note.title !== 'string' || typeof note.current_content !== 'string') {
        throw new Error('Invalid note response');
      }
      title = note.title;
      aiHash = note.current_hash;
      const index = await getKnowledgeIndex({ ...note, slug });
      bySlug = index.bySlug;
      const indexedCurrent = index.bySlug.get(slug);
      current = indexedCurrent ? await renderSingleNote(indexedCurrent, index) : undefined;
      if (current) neighbors = findNoteNeighbors(folderTree(index.notes), current.slug);
      html = current?.html ?? '';
    }
  } catch {
    Astro.response.status = 503;
    message = 'دریافت یادداشت موقتاً امکان‌پذیر نیست. دوباره تلاش کنید.';
  }
}
---
<Reader title={title} headings={current?.headings}>
  {message ? <p role="status">{message}</p> : <>{current && <NoteProperties note={current} statusText="نسخهٔ رسمی" />}
    <WorkspaceNote slug={slug} /><article class="note" data-ai-scope="canonical" data-ai-hash={aiHash} set:html={html} /><GeoGebra />

    <CanonicalActions slug={slug} title={title}/>
    {current && <><InlinePreviews /><SemanticConnections note={current} bySlug={bySlug} /><div class="note-connections"><Connections title="پیوندهای این یادداشت" direction="outgoing" currentSlug={current.slug} slugs={current.outgoing} bySlug={bySlug} /><Connections title="ارجاعات به این یادداشت" direction="incoming" currentSlug={current.slug} slugs={current.backlinks} bySlug={bySlug} /></div>{neighbors && (neighbors.prev || neighbors.next) && <NotePager {...neighbors} />}</>}</>}
  <div slot="tools">{!message && current && <NoteGraph slug={slug} />}</div>
</Reader>
<style>
  .note-connections{border-block-start:1px solid var(--workspace-border);margin-block-start:2rem;padding-block-start:1.5rem}
</style>
