---
import Reader from '../../layouts/Reader.astro';
---
<Reader title="کتابخانه">
<p>جزوه‌ها و یادداشت‌های شما در یک جا؛ ویرایش جزوه فقط برای حساب شما ذخیره می‌شود.</p>
<p><a href="/workspace">فعالیت‌ها، نشانه‌ها و پیشنهادهای من</a></p>
<div data-library-browser>
<div class="garden-row library-actions-top">
  <div class="library-views">
    <button data-library-view="items">یادداشت‌ها</button>
    <button data-library-view="favorites">علاقه‌مندی‌ها</button>
    <button data-library-view="watching">پیگیری‌ها</button>
    <button data-library-view="trash">زباله‌دان</button>
  </div>
  <button type="button" data-import-docs class="import-docs-btn">📥 درون‌ریزی مستندات (گیت / زیپ)</button>
</div>
<p role="status" data-browser-status></p><div data-browser-path></div>
<form data-create-item class="garden-row"><label>نام <input name="title" required maxlength="255"/></label><label>نوع <select name="kind"><option value="note">یادداشت</option><option value="folder">پوشه</option></select></label><button type="submit" disabled>ساختن</button></form>
<ul data-browser-list class="library-browser-list"></ul><button data-browser-more hidden>بیشتر</button>
</div>
</Reader>
<script>import '../../scripts/library-browser';</script>
<style>
.library-browser-list{list-style:none;padding:0}
.library-browser-list li{padding:.75rem 0;border-block-end:1px solid var(--border,#ddd);display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
.library-actions-top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1rem}
.library-views{display:flex;gap:.5rem;flex-wrap:wrap}
.import-docs-btn{background:var(--accent,#3b82f6);color:#fff;border:none;padding:.5rem 1rem;border-radius:6px;cursor:pointer;font-weight:600;font-size:.875rem;display:inline-flex;align-items:center;gap:.4rem}
.import-docs-btn:hover{opacity:.9}
</style>
