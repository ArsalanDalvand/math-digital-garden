---
import Reader from '../layouts/Reader.astro';
import LibraryActions from './LibraryActions.astro';
import {renderMarkdown} from '../lib/markdown.mjs';

interface Props {id?:string;token?:string}
const {id,token}=Astro.props;
const origin=process.env.API_BASE_URL||import.meta.env.API_BASE_URL||'http://127.0.0.1:8000';
const noteParam = Astro.url.searchParams.get('note');

let item:any=null;
try{
  const targetUrl = `${origin}/api/library/${token?'shared/'+encodeURIComponent(token):'public/'+encodeURIComponent(id!)}${noteParam ? '?note='+encodeURIComponent(noteParam) : ''}`;
  const response=await fetch(targetUrl,{signal:AbortSignal.timeout(5000)});
  if(response.ok) item=await response.json();
  else Astro.response.status=response.status;
}catch{
  Astro.response.status=503;
}

Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
const html=item?.content ? await renderMarkdown(item.content) : '';
---
<Reader documentPage title={item?.title||'مستندات منتشرشده'}>
{item ? (
  item.kind === 'folder' ? (
    <div class="shared-collection-layout">
      <header class="shared-collection-header">
        <div class="shared-header-info">
          <span class="shared-badge">مجموعه مستندات اشتراکی</span>
          <h1 class="shared-collection-title">{item.folder_title}</h1>
          {item.active_note_title && <p class="shared-current-note">یادداشت جاری: <strong>{item.active_note_title}</strong></p>}
        </div>
      </header>

      <div class="shared-collection-body">
        {item.tree && item.tree.length > 0 && (
          <aside class="shared-collection-nav" aria-label="فهرست مستندات">
            <h2 class="shared-nav-heading">فهرست یادداشت‌ها</h2>
            <nav class="shared-tree">
              {function renderNodes(nodes: any[], level = 0) {
                return (
                  <ul class={`shared-tree-list level-${level}`}>
                    {nodes.map((node: any) => (
                      <li class={`shared-tree-item kind-${node.kind}`}>
                        {node.kind === 'folder' ? (
                          <details open={level === 0}>
                            <summary class="shared-folder-label">📁 {node.title}</summary>
                            {node.children && renderNodes(node.children, level + 1)}
                          </details>
                        ) : (
                          <a
                            href={`/shared/${token || id}?note=${node.id}`}
                            class={`shared-note-link ${item.active_note_id === node.id ? 'active' : ''}`}
                          >
                            📄 {node.title}
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                );
              }(item.tree)}
            </nav>
          </aside>
        )}

        <main class="shared-collection-content">
          <article class="note" set:html={html || '<p>محتوایی برای این یادداشت وجود ندارد.</p>'} />
        </main>
      </div>
    </div>
  ) : (
    <>
      <p>نسخهٔ منتشرشده {item.verified ? '· تأییدشده توسط مدیر' : ''}</p>
      <LibraryActions id={item.id} publicView token={token}/>
      <article class="note" set:html={html}/>
    </>
  )
) : (
  <div class="shared-empty-state">
    <h2>یادداشت یا مستندات در دسترس نیست</h2>
    <p>این یادداشت ممکن است حذف شده باشد یا اشتراک‌گذاری آن توسط صاحب اثر لغو شده باشد.</p>
  </div>
)}
</Reader>

<style>
.shared-collection-layout {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-block-start: 1rem;
}
.shared-collection-header {
  padding: 1.25rem 1.5rem;
  background: var(--surface-2, rgba(255, 255, 255, 0.04));
  border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
  border-radius: 12px;
}
.shared-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent, #60a5fa);
  background: rgba(96, 165, 250, 0.12);
  padding: 0.2rem 0.6rem;
  border-radius: 9999px;
  margin-bottom: 0.5rem;
}
.shared-collection-title {
  margin: 0;
  font-size: 1.5rem;
  color: var(--text-1, #f3f4f6);
}
.shared-current-note {
  margin: 0.5rem 0 0 0;
  font-size: 0.9rem;
  color: var(--text-2, #9ca3af);
}
.shared-collection-body {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 2rem;
  align-items: start;
}
@media (max-width: 768px) {
  .shared-collection-body {
    grid-template-columns: 1fr;
  }
}
.shared-collection-nav {
  background: var(--surface-1, rgba(255, 255, 255, 0.02));
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: 12px;
  padding: 1.25rem;
  position: sticky;
  top: 1rem;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  scrollbar-width: thin;
}
.shared-nav-heading {
  font-size: 1rem;
  margin: 0 0 1rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  color: var(--text-1, #f3f4f6);
}
.shared-tree-list {
  list-style: none;
  padding-inline-start: 0.75rem;
  margin: 0;
}
.shared-tree-list.level-0 {
  padding-inline-start: 0;
}
.shared-tree-item {
  margin: 0.35rem 0;
}
.shared-folder-label {
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-1, #f3f4f6);
  padding: 0.3rem 0.5rem;
  border-radius: 6px;
  user-select: none;
}
.shared-folder-label:hover {
  background: var(--surface-2, rgba(255, 255, 255, 0.05));
}
.shared-note-link {
  display: block;
  font-size: 0.875rem;
  color: var(--text-2, #9ca3af);
  text-decoration: none;
  padding: 0.35rem 0.6rem;
  border-radius: 6px;
  transition: all 0.15s ease;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shared-note-link:hover {
  color: var(--text-1, #f3f4f6);
  background: var(--surface-2, rgba(255, 255, 255, 0.06));
}
.shared-note-link.active {
  color: var(--accent, #60a5fa);
  background: rgba(96, 165, 250, 0.15);
  font-weight: 600;
}
.shared-collection-content {
  background: var(--surface-1, rgba(255, 255, 255, 0.02));
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: 12px;
  padding: 2rem;
  min-height: 400px;
}
</style>
