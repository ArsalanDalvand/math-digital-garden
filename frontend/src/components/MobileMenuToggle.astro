---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
---
<MobileMenuToggle />
<script>
  // Starlight 0.37 updates the host attribute; screen readers need it on the button.
  const menu = document.querySelector('starlight-menu-button');
  if (menu) new MutationObserver(() => {
    menu.querySelector('button')?.setAttribute('aria-expanded', menu.getAttribute('aria-expanded') ?? 'false');
  }).observe(menu, { attributes: true, attributeFilter: ['aria-expanded'] });
</script>
