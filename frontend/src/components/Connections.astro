---
import type { IndexedNote } from '../lib/markdown.mjs';
import { noteHref } from '../lib/markdown.mjs';

interface Props {
  title: string;
  direction: 'outgoing' | 'incoming';
  currentSlug: string;
  slugs: string[];
  bySlug: Map<string, IndexedNote>;
}

const { title, direction, currentSlug, slugs, bySlug } = Astro.props;
const items = [...new Set(slugs)]
  .map((slug) => bySlug.get(slug))
  .filter((note): note is IndexedNote => Boolean(note));
---

{items.length > 0 && (
  <section class="connection-section" aria-label={title} data-connection-direction={direction}>
    <h2 class="connection-title">
      <span>{title}</span>
      <span class="connection-count">{items.length.toLocaleString('fa-IR')}</span>
    </h2>
    <ul class="connection-list">
      {items.map((item) => (
        <li class="connection-item">
          <div class="connection-row">
            <a class="connection-link" href={noteHref(item.slug)} data-note-preview={item.slug}>
              {item.title}
            </a>
            <details
              class="connection-preview-details"
              data-connection-preview={item.slug}
              data-current-slug={currentSlug}
            >
              <summary class="connection-preview-btn">پیش‌نمایش</summary>
              <div class="connection-preview-box note" data-connection-preview-body>
                <p class="connection-loading">در حال بارگذاری…</p>
              </div>
            </details>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  const previewCache = new Map<string, { html?: string; slogan?: string }>();
  document.querySelectorAll<HTMLDetailsElement>('[data-connection-preview]').forEach((details) => {
    details.addEventListener('toggle', async () => {
      if (!details.open) return;
      const slug = details.dataset.connectionPreview;
      const box = details.querySelector<HTMLElement>('[data-connection-preview-body]');
      if (!slug || !box) return;

      const renderIntoBox = (data: { html?: string; slogan?: string }) => {
        box.replaceChildren();
        if (data.slogan) {
          const p = document.createElement('p');
          p.className = 'connection-preview-slogan';
          p.textContent = data.slogan;
          box.append(p);
        }
        if (data.html) {
          const inner = document.createElement('div');
          inner.innerHTML = data.html;
          box.append(inner);
        } else if (!data.slogan) {
          const empty = document.createElement('p');
          empty.textContent = 'پیش‌نمایشی برای این یادداشت ثبت نشده است.';
          box.append(empty);
        }
        requestAnimationFrame(() => details.scrollIntoView({ block: 'nearest' }));
      };

      const cached = previewCache.get(slug);
      if (cached) {
        renderIntoBox(cached);
        return;
      }

      try {
        const res = await fetch(`/api/note-preview/${encodeURIComponent(slug)}`, {
          credentials: 'same-origin',
        });
        if (!res.ok) throw new Error('Failed');
        const data = (await res.json()) as { html?: string; slogan?: string };
        previewCache.set(slug, data);
        if (details.open) renderIntoBox(data);
      } catch {
        box.replaceChildren();
        const err = document.createElement('p');
        err.textContent = 'دریافت پیش‌نمایش ممکن نشد.';
        box.append(err);
      }
    });
  });
</script>

<style>
  .connection-section {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface-subtle);
    min-width: 0;
  }

  .connection-title {
    margin: 0 0 0.7rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .connection-count {
    font-size: 0.72rem;
    padding: 1px 7px;
    border-radius: 9999px;
    background: var(--surface-hover);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .connection-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .connection-item {
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.5rem 0.75rem;
  }

  .connection-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.75rem;
  }

  .connection-link {
    flex: 1 1 12rem;
    min-width: 0;
    color: var(--primary-text);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .connection-link:hover {
    text-decoration: underline;
  }

  .connection-preview-details {
    flex: 0 0 auto;
    max-width: 100%;
  }

  .connection-preview-details[open] {
    flex-basis: 100%;
  }

  .connection-preview-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 2px 10px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-subtle);
    color: var(--muted-foreground);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .connection-preview-btn::-webkit-details-marker {
    display: none;
  }

  .connection-preview-btn:hover,
  .connection-preview-details[open] > .connection-preview-btn {
    background: var(--surface-hover);
    color: var(--foreground);
  }

  .connection-preview-box {
    margin-top: 0.65rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background: var(--surface-subtle);
    font-size: 0.85rem;
    line-height: 1.75;
    max-height: 18rem;
    overflow-y: auto;
  }

  .connection-preview-slogan {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }

  .connection-loading {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
</style>
