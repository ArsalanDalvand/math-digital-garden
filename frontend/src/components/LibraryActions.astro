---
import { X } from 'lucide-react';

interface Props {
  id?: string;
  canonicalSlug?: string;
  publicView?: boolean;
  token?: string;
}
const { id = '', canonicalSlug = '', publicView = false, token = '' } = Astro.props;
---

<div
  data-library-actions={id}
  data-canonical-slug={canonicalSlug}
  data-public={String(publicView)}
  data-token={token}
>
  <div data-library-top class="garden-row">
    <button type="button" data-library-command="share">اشتراک‌گذاری</button>
    <button type="button" data-library-command="comments">دیدگاه‌ها</button>
  </div>
  <div data-library-menu class="library-menu">
    <button type="button" data-library-command="share" class="mobile-only-action">اشتراک‌گذاری</button>
    <button type="button" data-library-command="comments" class="mobile-only-action">دیدگاه‌ها</button>
    <button type="button" data-library-command="link">کپی پیوند</button>
    <button type="button" data-library-command="markdown">کپی Markdown</button>
    <button type="button" data-library-command="favorite" data-auth-only>افزودن به علاقه‌مندی‌ها</button>
    <button type="button" data-library-command="watch" data-auth-only>پیگیری یادداشت</button>
    <button type="button" data-library-command="width">عرض کامل</button>
    <button type="button" data-library-command="history" data-auth-only>تاریخچه</button>
    <button type="button" data-library-command="attachments" data-auth-only>پیوست‌ها</button>
    <button type="button" data-library-command="rename" data-auth-only>تغییر نام</button>
    <button type="button" data-library-command="move" data-auth-only>انتقال</button>
    <button type="button" data-library-command="gitsync" hidden>بروزرسانی از گیت</button>
    <button type="button" data-library-command="verify" hidden>تأیید نسخهٔ منتشرشده</button>
    <button type="button" data-library-command="trash" data-auth-only>انتقال به زباله‌دان</button>
    <small data-library-info></small>
  </div>
  <p role="status" aria-live="polite" data-library-status></p>
  <dialog
    data-library-dialog
    data-dialog-mode="modal"
    aria-labelledby={`library-dialog-title-${id}`}
  >
    <div class="library-dialog-header">
      <h2 id={`library-dialog-title-${id}`} data-library-title></h2>
      <button type="button" data-library-close aria-label="بستن" title="بستن">
        <X size={16} aria-hidden="true" />
      </button>
    </div>
    <p role="status" aria-live="polite" data-library-dialog-status></p>
    <div data-library-body></div>
  </dialog>
</div>

<script>
  import '../scripts/library-actions';
</script>
