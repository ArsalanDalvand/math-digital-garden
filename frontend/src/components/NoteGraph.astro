---
import 'starlight-site-graph/styles/common.css';
import 'starlight-site-graph/styles/variables.css';
import 'starlight-site-graph/styles/starlight.css';
import { graphSitemap } from '../lib/graph.mjs';
import { noteHref, buildKnowledge } from '../lib/markdown.mjs';
interface Props { garden: Awaited<ReturnType<typeof buildKnowledge>>; slug: string }
const { garden, slug } = Astro.props;
// UMKO v1.1 Semantic Graph Configuration
const config = {
  depth: 1,
  prefetchPages: false,
  renderExternal: false,
  labelFontSize: 13,
  linkDistance: 130,
  repelForce: 130,
  centerForce: 0.15,
  renderArrows: true,
  tagRenderMode: 'same',
  tagStyles: {
    '#kind:assertion': { shape: 'circle', shapeSize: 9, shapeColor: '#1d4ed8', strokeColor: '#60a5fa', strokeWidth: 1.5 },
    '#kind:concept': { shape: 'circle', shapeSize: 9, shapeColor: '#0d9488', strokeColor: '#2dd4bf', strokeWidth: 1.5 },
    '#kind:proof': { shape: 'circle', shapeSize: 8, shapeColor: '#64748b', strokeColor: '#94a3b8', strokeWidth: 1.5 },
    '#kind:problem': { shape: 'circle', shapeSize: 9, shapeColor: '#ea580c', strokeColor: '#fb923c', strokeWidth: 1.5 },
    '#kind:solution': { shape: 'circle', shapeSize: 8, shapeColor: '#059669', strokeColor: '#34d399', strokeWidth: 1.5 },
    '#kind:technique': { shape: 'circle', shapeSize: 8, shapeColor: '#d97706', strokeColor: '#fbbf24', strokeWidth: 1.5 },
    '#kind:hint_ladder': { shape: 'circle', shapeSize: 7, shapeColor: '#d97706', strokeColor: '#f59e0b', strokeWidth: 1.5 },
    '#kind:problem_archetype': { shape: 'circle', shapeSize: 9, shapeColor: '#c026d3', strokeColor: '#e879f9', strokeWidth: 2 },
    '#kind:pitfall': { shape: 'circle', shapeSize: 8, shapeColor: '#b45309', strokeColor: '#f59e0b', strokeWidth: 2 },
    '#kind:visual_lab': { shape: 'circle', shapeSize: 9, shapeColor: '#0284c7', strokeColor: '#38bdf8', strokeWidth: 1.5 },
    '#kind:collection': { shape: 'circle', shapeSize: 12, shapeColor: '#7c3aed', strokeColor: '#c084fc', strokeWidth: 2 },
    '#kind:axiom': { shape: 'circle', shapeSize: 9, shapeColor: '#0e7490', strokeColor: '#22d3ee', strokeWidth: 1.5 },
    '#kind:theory': { shape: 'circle', shapeSize: 11, shapeColor: '#4338ca', strokeColor: '#818cf8', strokeWidth: 2 },
    '#kind:remark': { shape: 'circle', shapeSize: 7, shapeColor: '#64748b', strokeColor: '#cbd5e1', strokeWidth: 1 },
  },
  actions: ['reset-zoom', 'fullscreen', 'render-arrows', 'settings'],
};
---
<section data-note-graph class="note-graph" aria-label="گراف ارتباط یادداشت‌ها">
  <div class="note-graph-header">
    <h2>گراف ارتباط یادداشت‌ها</h2>
    <div class="graph-depth-quickbar">
      <span class="depth-label">شعاع:</span>
      <button type="button" class="depth-chip active" data-depth="1" title="همسایگان مستقیم (عمق ۱)">۱ گام</button>
      <button type="button" class="depth-chip" data-depth="2" title="دو لایه ارتباطی (عمق ۲)">۲ گام</button>
      <button type="button" class="depth-chip" data-depth="5" title="کل پایگاه دانش">سراسری</button>
    </div>
  </div>
  <p>برای مطالعه، نودها را انتخاب کنید. <a href="/search">فهرست متنی همهٔ یادداشت‌ها</a></p>
  <button type="button" class="garden-secondary" data-load-graph>نمایش گراف ارتباطات</button>
  <p role="status" data-graph-status></p>
  <template data-graph-template>
    <div class="slsg-graph-component slsg-graph-skeleton"><div class="slsg-graph-container"></div></div>
    <graph-component data-config={JSON.stringify(config)} data-sitemap={JSON.stringify(graphSitemap(garden))} data-slug={noteHref(slug).slice(1)} data-debug="false" data-trailing-slashes="false"></graph-component>
  </template>
  <div class="graph-umko-legend" aria-label="راهنمای دسته‌بندی گره‌های گراف">
    <span class="legend-badge" style="--badge-c: #1d4ed8">● قضیه</span>
    <span class="legend-badge" style="--badge-c: #0d9488">● مفهوم</span>
    <span class="legend-badge" style="--badge-c: #ea580c">● مسئله</span>
    <span class="legend-badge" style="--badge-c: #059669">● راه‌حل</span>
    <span class="legend-badge" style="--badge-c: #7c3aed">● نقشه راه</span>
    <span class="legend-badge" style="--badge-c: #0284c7">● شبیه‌ساز</span>
    <span class="legend-badge" style="--badge-c: #b45309">● دام</span>
  </div>
  <noscript>برای گراف تعاملی جاوااسکریپت را فعال کنید؛ فهرست پیوندها در ادامه در دسترس است.</noscript>
</section>

<style>
  .note-graph-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); margin-block-end: var(--space-2); }
  .note-graph-header h2 { margin: 0; font-size: 1.05rem; font-weight: 700; }
  .graph-depth-quickbar { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; }
  .depth-label { color: var(--muted); }
  .depth-chip { min-height: 24px; height: 24px; padding: 0 0.45rem; font-size: 0.75rem; border-radius: 4px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); cursor: pointer; transition: all 0.15s ease; }
  .depth-chip:hover { border-color: var(--accent); color: var(--accent); }
  .depth-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }
  .graph-umko-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.725rem; margin-block-start: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--border); }
  .legend-badge { color: var(--badge-c); display: inline-flex; align-items: center; gap: 0.15rem; background: color-mix(in srgb, var(--badge-c) 8%, var(--surface)); padding: 0.1rem 0.4rem; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--badge-c) 30%, var(--border)); }
</style>
<script>
  const labels: Record<string,string> = {
    fullscreen: 'تمام‌صفحه یا بازگشت', depth: 'تغییر عمق ارتباطات؛ سطح ۵ گراف سراسری',
    'reset-zoom': 'بازنشانی زوم', 'render-arrows': 'نمایش یا حذف جهت پیوندها', settings: 'تنظیمات گراف',
    'Repel Force': 'نیروی دافعه', 'Center Force': 'نیروی مرکز', 'Collider Padding': 'فاصلهٔ نودها',
    'Link Distance': 'طول پیوندها', 'Alpha Decay': 'سرعت آرام‌شدن حرکت',
  };
  // The upstream controls have no accessible names; keep names after they regenerate.
  function fitGraph(graph:any){
    const sim=graph.simulator;const canvas=graph.querySelector('canvas');if(!sim?.nodes?.length||!canvas)return;
    const nodes=sim.nodes.filter((n:any)=>Number.isFinite(n.x)&&Number.isFinite(n.y));if(!nodes.length)return;
    const xs=nodes.map((n:any)=>n.x),ys=nodes.map((n:any)=>n.y);const left=Math.min(...xs),right=Math.max(...xs),top=Math.min(...ys),bottom=Math.max(...ys);
    const w=canvas.clientWidth,h=canvas.clientHeight;if(!w||!h)return;
    const k=Math.min(1,(w-100)/Math.max(1,right-left),(h-70)/Math.max(1,bottom-top));
    const x=w/2-(left+right)/2*k,y=h/2-(top+bottom)/2*k;
    sim.userZoomed=true;sim.centerTransform=sim.centerTransform.translate(-sim.centerTransform.x,-sim.centerTransform.y);sim.zoomTransform=sim.zoomTransform.constructor===Object?sim.zoomTransform:new sim.zoomTransform.constructor(k,x,y);sim.transform=sim.zoomTransform;sim.renderer.resetZoom(sim.zoomTransform);sim.updateZoom(k,x,y,true);sim.requestRender=true;
  }
  function nameGraph(graph: HTMLElement) {
    graph.style.opacity='0';setTimeout(()=>{if(graph.isConnected){fitGraph(graph);graph.style.opacity='1';}},1800);
    const nameControls = () => {
      let actions: string[] = ['fullscreen','depth','reset-zoom','render-arrows','settings'];
      try {
        const parsed = JSON.parse(graph.dataset.config ?? '{}');
        if (Array.isArray(parsed.actions)) actions = parsed.actions;
      } catch {}
      graph.querySelectorAll<HTMLButtonElement>('.slsg-graph-action-button').forEach((button,index) => {
        const action = actions[index];
        button.type = 'button';
        button.dataset.graphAction = action;
        button.setAttribute('aria-label', labels[action] ?? action);
        button.title = labels[action] ?? action;
      });
      const popup=graph.querySelector('.slsg-popup-menu');
      if(popup&&!popup.querySelector('[data-extra-settings]')){const extra=document.createElement('div');extra.dataset.extraSettings='';extra.innerHTML='<label>عمق ارتباطات <select aria-label="عمق ارتباطات"><option value="0">فقط این یادداشت</option><option value="1">همسایه‌ها</option><option value="2">دو مرحله</option><option value="3">سه مرحله</option><option value="4">چهار مرحله</option><option value="5">همه یادداشت‌ها</option></select></label><label><input type="checkbox"/> جهت پیوندها</label>';const g=graph as any;const select=extra.querySelector('select')!;select.value=String(g.config.depth);select.onchange=()=>{g.config.depth=Number(select.value);g.full_refresh();setTimeout(()=>fitGraph(g),1000)};const check=extra.querySelector('input')!;check.checked=g.config.renderArrows;check.onchange=()=>{g.config.renderArrows=check.checked;g.simulator.requestRender=true};popup.prepend(extra);}
      graph.querySelectorAll<HTMLElement>('.slsg-value-slider').forEach(slider => {
        const label = slider.querySelector<HTMLElement>('.slsg-value-slider-label');
        const input = slider.querySelector('input');
        if (label && input) {
          const name = labels[label.textContent ?? ''] ?? label.textContent ?? '';
          if (label.textContent !== name) label.textContent = name;
          input.setAttribute('aria-label', name);
        }
      });
      const canvas = graph.querySelector('canvas');
      canvas?.setAttribute('role','img');
      canvas?.setAttribute('aria-label','نمودار ارتباطات؛ فهرست متنی پیوندها در ادامهٔ صفحه است');
    };
    const observer = new MutationObserver(nameControls);
    observer.observe(graph, {childList:true,subtree:true});
    document.addEventListener('astro:before-swap', () => observer.disconnect(), {once:true});
    nameControls();
    graph.addEventListener('click',event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-graph-action]');
      if(button?.dataset.graphAction==='reset-zoom')setTimeout(()=>fitGraph(graph),30);
      if (button && document.activeElement === button) {
        // Upstream data-config observers may regenerate actions again in a later microtask.
        setTimeout(() => {
          nameControls();
          if (!button.isConnected) graph.querySelector<HTMLButtonElement>(`[data-graph-action="${button.dataset.graphAction}"]`)?.focus();
        });
      }
    },true);
    graph.addEventListener('keydown',event => {
      if (event.key === 'Escape' && graph.querySelector('.slsg-popup-menu')) {
        graph.querySelector('.slsg-popup-menu')?.remove();
        graph.querySelector<HTMLButtonElement>('[data-graph-action="settings"]')?.focus();
      }
    });
  }

  // Universal 2D Canvas Knowledge Graph Engine (Resilient, zero-race-condition renderer)
  function init2DGraphEngine(host: HTMLElement) {
    if (typeof document.createElement !== 'function') return;
    const probe = document.createElement('canvas');
    let has2D = false;
    try {
      has2D = !!(typeof probe.getContext === 'function' && probe.getContext('2d'));
    } catch {
      has2D = false;
    }
    if (!has2D) return;

    const gc = host.querySelector<HTMLElement>('graph-component') || host;
    const template = host.querySelector<HTMLTemplateElement>('[data-graph-template]');
    const rawSitemap = gc.dataset.sitemap || template?.content.querySelector('graph-component')?.dataset.sitemap || '{}';
    const rawSlug = gc.dataset.slug || template?.content.querySelector('graph-component')?.dataset.slug || '';
    let sitemap: Record<string, any> = {};
    try { sitemap = JSON.parse(rawSitemap); } catch { return; }
    const currentSlug = rawSlug;

    const skeleton = host.querySelector<HTMLElement>('.slsg-graph-skeleton');
    if (skeleton) skeleton.style.display = 'none';

    let container = gc.querySelector<HTMLElement>('.slsg-graph-container');
    if (!container) container = host.querySelector<HTMLElement>('.slsg-graph-container');
    if (!container) {
      container = document.createElement('div');
      container.className = 'slsg-graph-container';
      container.tabIndex = 0;
      gc.appendChild(container);
    }
    // Remove any conflicting WebGL canvas so 2D context never returns null
    container.querySelectorAll('canvas:not(.graph-canvas-2d)').forEach(c => c.remove());
    container.style.position = 'relative';
    container.style.width = '100%';
    container.style.height = '100%';
    container.style.minHeight = '210px';
    container.style.overflow = 'hidden';
    container.style.borderRadius = '8px';

    gc.style.visibility = 'visible';
    gc.style.display = 'block';
    gc.style.opacity = '1';

    const kindColors: Record<string, string> = {
      assertion: '#1d4ed8', concept: '#0d9488', proof: '#64748b',
      problem: '#ea580c', solution: '#059669', technique: '#d97706',
      hint_ladder: '#d97706', problem_archetype: '#c026d3', pitfall: '#b45309',
      visual_lab: '#0284c7', collection: '#7c3aed', axiom: '#0e7490',
      theory: '#4338ca', remark: '#64748b'
    };
    const kindStrokes: Record<string, string> = {
      assertion: '#60a5fa', concept: '#2dd4bf', proof: '#94a3b8',
      problem: '#fb923c', solution: '#34d399', technique: '#fbbf24',
      hint_ladder: '#f59e0b', problem_archetype: '#e879f9', pitfall: '#f59e0b',
      visual_lab: '#38bdf8', collection: '#c084fc', axiom: '#22d3ee',
      theory: '#818cf8', remark: '#cbd5e1'
    };
    const kindSizes: Record<string, number> = {
      collection: 13, theory: 12, assertion: 10, concept: 10, problem: 10,
      visual_lab: 10, axiom: 10, problem_archetype: 10, proof: 8,
      solution: 8, technique: 8, pitfall: 8, hint_ladder: 7, remark: 7
    };

    let currentDepth = Number((gc as any).config?.depth ?? 1);
    let renderArrows = (gc as any).config?.renderArrows !== false;

    let canvas = container.querySelector<HTMLCanvasElement>('canvas');
    if (!canvas) {
      canvas = document.createElement('canvas');
      canvas.className = 'graph-canvas-2d';
      canvas.setAttribute('role', 'img');
      canvas.setAttribute('aria-label', 'نمودار ارتباطات؛ فهرست متنی پیوندها در ادامهٔ صفحه است');
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.style.display = 'block';
      container.prepend(canvas);
    }

    let ctx: CanvasRenderingContext2D | null = null;
    try {
      ctx = typeof canvas.getContext === 'function' ? canvas.getContext('2d') : null;
    } catch {
      ctx = null;
    }
    if (!ctx) return;

    const raf = typeof requestAnimationFrame === 'function'
      ? requestAnimationFrame
      : ((cb: FrameRequestCallback) => setTimeout(() => cb(Date.now()), 16) as unknown as number);
    const caf = typeof cancelAnimationFrame === 'function'
      ? cancelAnimationFrame
      : clearTimeout;
    let scale = 1;
    let panX = 0;
    let panY = 0;
    let nodes: any[] = [];
    let links: any[] = [];
    let hoveredNode: any = null;
    let draggedNode: any = null;
    let isPanning = false;
    let startMouseX = 0;
    let startMouseY = 0;
    let startPanX = 0;
    let startPanY = 0;
    let animId = 0;
    let alpha = 1;

    function buildSubgraph(depth: number) {
      const visited = new Set<string>();
      if (sitemap[currentSlug]) visited.add(currentSlug);
      let frontier = [currentSlug];

      if (depth >= 5) {
        for (const k of Object.keys(sitemap)) visited.add(k);
      } else {
        for (let d = 0; d < depth; d++) {
          const next: string[] = [];
          for (const id of frontier) {
            const item = sitemap[id];
            if (!item) continue;
            for (const n of [...(item.links || []), ...(item.backlinks || [])]) {
              if (sitemap[n] && !visited.has(n)) {
                visited.add(n);
                next.push(n);
              }
            }
          }
          frontier = next;
        }
      }

      const newNodes: any[] = [];
      const nodeMap = new Map<string, any>();
      const width = canvas?.clientWidth || 300;
      const height = canvas?.clientHeight || 300;
      const centerX = width / 2;
      const centerY = height / 2;

      let idx = 0;
      const total = visited.size;
      for (const id of visited) {
        const item = sitemap[id];
        if (!item) continue;
        const isCurrent = id === currentSlug;
        const radius = isCurrent ? 14 : (kindSizes[item.kind] || 9);
        const color = isCurrent ? '#06b6d4' : (kindColors[item.kind] || '#64748b');
        const stroke = isCurrent ? '#67e8f9' : (kindStrokes[item.kind] || '#94a3b8');

        let x = centerX;
        let y = centerY;
        if (!isCurrent) {
          const angle = idx * (Math.PI * 2 / Math.min(total, 16)) + (idx * 0.3);
          const dist = 60 + Math.floor(idx / 12) * 55;
          x = centerX + Math.cos(angle) * dist;
          y = centerY + Math.sin(angle) * dist;
        }

        const node = {
          id,
          title: item.title || id.replace('notes/', ''),
          kind: item.kind || '',
          slogan: item.slogan || '',
          isCurrent,
          radius,
          color,
          stroke,
          x,
          y,
          vx: 0,
          vy: 0,
        };
        newNodes.push(node);
        nodeMap.set(id, node);
        idx++;
      }

      const newLinks: any[] = [];
      for (const id of visited) {
        const item = sitemap[id];
        if (!item) continue;
        const src = nodeMap.get(id);
        if (!src) continue;
        for (const tId of (item.links || [])) {
          const tgt = nodeMap.get(tId);
          if (tgt && tgt !== src) {
            newLinks.push({ source: src, target: tgt });
          }
        }
      }

      nodes = newNodes;
      links = newLinks;
      alpha = 1;
      simulateAndRender();
      setTimeout(autoFit, 100);
    }

    function autoFit() {
      if (!canvas || !nodes.length) return;
      const validNodes = nodes.filter(n => Number.isFinite(n.x) && Number.isFinite(n.y));
      if (!validNodes.length) return;
      const xs = validNodes.map(n => n.x);
      const ys = validNodes.map(n => n.y);
      const left = Math.min(...xs);
      const right = Math.max(...xs);
      const top = Math.min(...ys);
      const bottom = Math.max(...ys);

      const w = canvas.clientWidth || 300;
      const h = canvas.clientHeight || 300;
      const pad = 50;
      const spanX = Math.max(1, right - left);
      const spanY = Math.max(1, bottom - top);
      scale = Math.min(1.2, Math.max(0.15, Math.min((w - pad * 2) / spanX, (h - pad * 2) / spanY)));
      panX = w / 2 - ((left + right) / 2) * scale;
      panY = h / 2 - ((top + bottom) / 2) * scale;
      requestDraw();
    }

    let repelStrength = 130;
    let springDistance = 85;

    function updateSimulation() {
      if (alpha < 0.005) return false;
      const w = canvas?.clientWidth || 300;
      const h = canvas?.clientHeight || 300;
      const cx = w / 2;
      const cy = h / 2;
      const repelForce = repelStrength * alpha;
      const springLength = springDistance;
      const springK = 0.05 * alpha;

      for (let i = 0; i < nodes.length; i++) {
        const n1 = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const n2 = nodes[j];
          let dx = n1.x - n2.x;
          let dy = n1.y - n2.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) { dx = (Math.random() - 0.5) * 2; dy = (Math.random() - 0.5) * 2; d2 = dx * dx + dy * dy; }
          const dist = Math.sqrt(d2);
          if (dist > 320) continue;
          const f = repelForce / (dist * dist);
          const fx = (dx / dist) * f;
          const fy = (dy / dist) * f;
          if (n1 !== draggedNode) { n1.vx += fx; n1.vy += fy; }
          if (n2 !== draggedNode) { n2.vx -= fx; n2.vy -= fy; }
        }
      }

      for (const link of links) {
        const src = link.source;
        const tgt = link.target;
        const dx = tgt.x - src.x;
        const dy = tgt.y - src.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const f = (dist - springLength) * springK;
        const fx = (dx / dist) * f;
        const fy = (dy / dist) * f;
        if (src !== draggedNode) { src.vx += fx; src.vy += fy; }
        if (tgt !== draggedNode) { tgt.vx -= fx; tgt.vy -= fy; }
      }

      for (const n of nodes) {
        if (n === draggedNode) continue;
        n.vx += (cx - n.x) * (0.015 * alpha);
        n.vy += (cy - n.y) * (0.015 * alpha);
        n.vx *= 0.82;
        n.vy *= 0.82;
        n.x += n.vx;
        n.y += n.vy;
      }

      alpha *= 0.96;
      return true;
    }

    function draw() {
      if (!canvas || !ctx) return;
      const isDark = document.documentElement.dataset.theme === 'dark';
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth || 300;
      const h = canvas.clientHeight || 300;
      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }

      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      ctx.save();
      ctx.translate(panX, panY);
      ctx.scale(scale, scale);

      const connected = new Set<any>();
      if (hoveredNode) {
        connected.add(hoveredNode);
        for (const l of links) {
          if (l.source === hoveredNode) connected.add(l.target);
          if (l.target === hoveredNode) connected.add(l.source);
        }
      }

      for (const l of links) {
        const isHoveredLink = hoveredNode && (l.source === hoveredNode || l.target === hoveredNode);
        const isFaded = hoveredNode && !isHoveredLink;

        ctx.beginPath();
        ctx.moveTo(l.source.x, l.source.y);
        ctx.lineTo(l.target.x, l.target.y);
        ctx.strokeStyle = isHoveredLink
          ? (isDark ? '#38bdf8' : '#0284c7')
          : isFaded
          ? (isDark ? 'rgba(71, 85, 105, 0.2)' : 'rgba(148, 163, 184, 0.2)')
          : (isDark ? 'rgba(148, 163, 184, 0.35)' : 'rgba(100, 116, 139, 0.38)');
        ctx.lineWidth = isHoveredLink ? 2.2 : 1.2;
        ctx.stroke();

        if (renderArrows) {
          const dx = l.target.x - l.source.x;
          const dy = l.target.y - l.source.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist > l.target.radius + 10) {
            const angle = Math.atan2(dy, dx);
            const arrowX = l.target.x - Math.cos(angle) * (l.target.radius + 2);
            const arrowY = l.target.y - Math.sin(angle) * (l.target.radius + 2);
            const headlen = isHoveredLink ? 8 : 6;
            ctx.beginPath();
            ctx.moveTo(arrowX, arrowY);
            ctx.lineTo(arrowX - headlen * Math.cos(angle - Math.PI / 6), arrowY - headlen * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(arrowX - headlen * Math.cos(angle + Math.PI / 6), arrowY - headlen * Math.sin(angle + Math.PI / 6));
            ctx.closePath();
            ctx.fillStyle = ctx.strokeStyle;
            ctx.fill();
          }
        }
      }

      for (const n of nodes) {
        const isFaded = hoveredNode && !connected.has(n);
        const isHovered = hoveredNode === n;

        if (n.isCurrent) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.radius + 5, 0, Math.PI * 2);
          ctx.strokeStyle = isDark ? '#06b6d4' : '#0891b2';
          ctx.lineWidth = 2.5;
          ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx.fillStyle = isFaded ? (isDark ? 'rgba(71, 85, 105, 0.4)' : 'rgba(148, 163, 184, 0.45)') : n.color;
        ctx.fill();

        ctx.strokeStyle = isHovered
          ? (isDark ? '#ffffff' : '#0f172a')
          : (isFaded ? 'rgba(100, 116, 139, 0.3)' : n.stroke);
        ctx.lineWidth = isHovered ? 2.5 : 1.5;
        ctx.stroke();

        if (nodes.length <= 35 || scale > 0.6 || isHovered || n.isCurrent || (hoveredNode && connected.has(n))) {
          const shortTitle = n.title.length > 26 && !isHovered ? n.title.slice(0, 24) + '…' : n.title;
          ctx.font = (n.isCurrent ? '600 ' : '') + '11px Vazirmatn, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';
          ctx.lineWidth = 3;
          ctx.strokeStyle = isDark ? 'rgba(15, 23, 42, 0.85)' : 'rgba(255, 255, 255, 0.9)';
          ctx.strokeText(shortTitle, n.x, n.y + n.radius + 4);
          ctx.fillStyle = isFaded
            ? (isDark ? 'rgba(148, 163, 184, 0.45)' : 'rgba(100, 116, 139, 0.5)')
            : (isDark ? '#f1f5f9' : '#0f172a');
          ctx.fillText(shortTitle, n.x, n.y + n.radius + 4);
        }
      }

      ctx.restore();

      if (hoveredNode) {
        const sx = hoveredNode.x * scale + panX;
        const sy = hoveredNode.y * scale + panY;
        const title = hoveredNode.title;
        const kindText = hoveredNode.kind ? `[${hoveredNode.kind}] ` : '';
        const tipText = kindText + title;

        ctx.font = '12px Vazirmatn, sans-serif';
        const textWidth = ctx.measureText(tipText).width;
        const boxW = Math.max(textWidth + 24, 100);
        const boxH = 30;
        let boxX = sx - boxW / 2;
        let boxY = sy - hoveredNode.radius * scale - boxH - 10;
        if (boxX < 10) boxX = 10;
        if (boxX + boxW > w - 10) boxX = w - boxW - 10;
        if (boxY < 10) boxY = sy + hoveredNode.radius * scale + 15;

        ctx.fillStyle = 'rgba(15, 23, 42, 0.92)';
        ctx.strokeStyle = hoveredNode.color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        if (typeof (ctx as any).roundRect === 'function') {
          (ctx as any).roundRect(boxX, boxY, boxW, boxH, 6);
        } else {
          ctx.rect(boxX, boxY, boxW, boxH);
        }
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#f8fafc';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(tipText, boxX + boxW / 2, boxY + boxH / 2);
      }

      ctx.restore();
    }

    function requestDraw() {
      if (animId) caf(animId);
      animId = raf(draw);
    }

    function simulateAndRender() {
      if (animId) caf(animId);
      function loop() {
        const stillRunning = updateSimulation();
        draw();
        if (stillRunning) {
          animId = raf(loop);
        }
      }
      animId = raf(loop);
    }

    function getNodeAt(clientX: number, clientY: number) {
      if (!canvas) return null;
      const rect = canvas.getBoundingClientRect();
      const mx = clientX - rect.left;
      const my = clientY - rect.top;
      const gx = (mx - panX) / scale;
      const gy = (my - panY) / scale;
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const dx = n.x - gx;
        const dy = n.y - gy;
        if (dx * dx + dy * dy <= (n.radius + 4) * (n.radius + 4)) {
          return n;
        }
      }
      return null;
    }

    let downX = 0;
    let downY = 0;
    let didDrag = false;

    canvas.addEventListener('mousedown', (e: MouseEvent) => {
      downX = e.clientX;
      downY = e.clientY;
      didDrag = false;
      const hit = getNodeAt(e.clientX, e.clientY);
      if (hit) {
        draggedNode = hit;
        alpha = 0.5;
        simulateAndRender();
      } else {
        isPanning = true;
        startMouseX = e.clientX;
        startMouseY = e.clientY;
        startPanX = panX;
        startPanY = panY;
      }
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if ((draggedNode || isPanning) && Math.hypot(e.clientX - downX, e.clientY - downY) > 5) {
        didDrag = true;
      }
      if (draggedNode && canvas) {
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        draggedNode.x = (mx - panX) / scale;
        draggedNode.y = (my - panY) / scale;
        draggedNode.vx = 0;
        draggedNode.vy = 0;
        alpha = 0.3;
        simulateAndRender();
        return;
      }
      if (isPanning) {
        panX = startPanX + (e.clientX - startMouseX);
        panY = startPanY + (e.clientY - startMouseY);
        requestDraw();
        return;
      }
      if (canvas && canvas.isConnected) {
        const rect = canvas.getBoundingClientRect();
        if (e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom) {
          const hit = getNodeAt(e.clientX, e.clientY);
          if (hit !== hoveredNode) {
            hoveredNode = hit;
            canvas.style.cursor = hit ? 'pointer' : 'default';
            requestDraw();
          }
        } else if (hoveredNode) {
          hoveredNode = null;
          requestDraw();
        }
      }
    });

    window.addEventListener('mouseup', () => {
      if (draggedNode) {
        draggedNode = null;
        alpha = 0.2;
        simulateAndRender();
      }
      isPanning = false;
    });

    canvas.addEventListener('click', (e: MouseEvent) => {
      if (didDrag) {
        didDrag = false;
        return;
      }
      const hit = getNodeAt(e.clientX, e.clientY);
      if (hit && hit.id && !hit.isCurrent) {
        window.location.href = '/' + hit.id;
      }
    });

    canvas.addEventListener('wheel', (e: WheelEvent) => {
      e.preventDefault();
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const zoomFactor = e.deltaY < 0 ? 1.15 : 0.87;
      const newScale = Math.min(2.5, Math.max(0.15, scale * zoomFactor));

      panX = mx - (mx - panX) * (newScale / scale);
      panY = my - (my - panY) * (newScale / scale);
      scale = newScale;
      requestDraw();
    }, { passive: false });

    let actionContainer = container.querySelector<HTMLElement>('.slsg-graph-action-container');
    if (!actionContainer) {
      actionContainer = document.createElement('div');
      actionContainer.className = 'slsg-graph-action-container';
      container.appendChild(actionContainer);
    }
    actionContainer.style.position = 'absolute';
    actionContainer.style.top = '8px';
    actionContainer.style.left = '8px';
    actionContainer.style.right = 'auto';
    actionContainer.style.zIndex = '10';
    actionContainer.innerHTML = `
      <button class="slsg-graph-action-button" type="button" data-graph-action="reset-zoom" aria-label="بازنشانی زوم" title="بازنشانی زوم">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-focus"><circle cx="12" cy="12" r="3"></circle><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path></svg>
      </button>
      <button class="slsg-graph-action-button" type="button" data-graph-action="fullscreen" aria-label="تمام‌صفحه یا بازگشت" title="تمام‌صفحه یا بازگشت">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg>
      </button>
      <button class="slsg-graph-action-button" type="button" data-graph-action="render-arrows" aria-label="نمایش یا حذف جهت پیوندها" title="نمایش یا حذف جهت پیوندها">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="5" r="3"></circle><path d="M8 5h9a2 2 0 0 1 2 2v8"></path><path d="m12 8-3-3 3-3"></path><circle cx="19" cy="19" r="3"></circle></svg>
      </button>
      <button class="slsg-graph-action-button" type="button" data-graph-action="settings" aria-label="تنظیمات گراف" title="تنظیمات گراف">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal"><line x1="21" x2="14" y1="4" y2="4"></line><line x1="10" x2="3" y1="4" y2="4"></line><line x1="21" x2="12" y1="12" y2="12"></line><line x1="8" x2="3" y1="12" y2="12"></line><line x1="21" x2="16" y1="20" y2="20"></line><line x1="12" x2="3" y1="20" y2="20"></line><line x1="14" x2="14" y1="2" y2="6"></line><line x1="8" x2="8" y1="10" y2="14"></line><line x1="16" x2="16" y1="18" y2="22"></line></svg>
      </button>
    `;

    const setDepth = (depth: number) => {
      currentDepth = depth;
      (gc as any).config.depth = depth;
      host.querySelectorAll<HTMLButtonElement>('[data-depth]').forEach(c => {
        c.classList.toggle('active', Number(c.dataset.depth) === depth);
      });
      buildSubgraph(depth);
    };

    const toggleFullscreen = (force?: boolean) => {
      const next = typeof force === 'boolean' ? force : !container!.classList.contains('slsg-is-fullscreen');
      container!.classList.toggle('slsg-is-fullscreen', next);
      (gc as any).isFullscreen = next;
      document.body.dataset['graphBlur'] = next ? 'true' : '';
      setTimeout(autoFit, 80);
    };

    actionContainer.querySelector('[data-graph-action="reset-zoom"]')?.addEventListener('click', autoFit);
    actionContainer.querySelector('[data-graph-action="fullscreen"]')?.addEventListener('click', () => toggleFullscreen());
    actionContainer.querySelector('[data-graph-action="render-arrows"]')?.addEventListener('click', () => {
      renderArrows = !renderArrows;
      if ((gc as any).config) (gc as any).config.renderArrows = renderArrows;
      requestDraw();
    });
    actionContainer.querySelector('[data-graph-action="settings"]')?.addEventListener('click', () => {
      const existing = gc.querySelector('.slsg-popup-menu');
      if (existing) { existing.remove(); return; }
      const popup = document.createElement('div');
      popup.className = 'slsg-popup-menu';
      popup.innerHTML = `
        <div class="slsg-popup-menu-content">
          <label>عمق ارتباطات
            <select aria-label="عمق ارتباطات">
              <option value="0">فقط این یادداشت</option>
              <option value="1">همسایه‌ها (۱ گام)</option>
              <option value="2">دو مرحله (۲ گام)</option>
              <option value="5">همه یادداشت‌ها (سراسری)</option>
            </select>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" ${renderArrows ? 'checked' : ''}/> نمایش جهت پیوندها
          </label>
          <div class="slsg-value-slider">
            <span class="slsg-value-slider-label">نیروی دافعه</span>
            <input type="range" min="40" max="320" value="${repelStrength}" aria-label="نیروی دافعه"/>
          </div>
          <div class="slsg-value-slider">
            <span class="slsg-value-slider-label">طول پیوندها</span>
            <input type="range" min="40" max="180" value="${springDistance}" aria-label="طول پیوندها"/>
          </div>
        </div>
      `;
      const select = popup.querySelector('select')!;
      select.value = String((gc as any).config?.depth ?? currentDepth);
      select.onchange = () => setDepth(Number(select.value));
      const check = popup.querySelector<HTMLInputElement>('input[type="checkbox"]')!;
      check.onchange = () => {
        renderArrows = check.checked;
        if ((gc as any).config) (gc as any).config.renderArrows = renderArrows;
        requestDraw();
      };
      const ranges = popup.querySelectorAll<HTMLInputElement>('input[type="range"]');
      if (ranges[0]) ranges[0].oninput = () => { repelStrength = Number(ranges[0].value); alpha = 0.6; simulateAndRender(); };
      if (ranges[1]) ranges[1].oninput = () => { springDistance = Number(ranges[1].value); alpha = 0.6; simulateAndRender(); };
      gc.appendChild(popup);
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      const popup = gc.querySelector('.slsg-popup-menu');
      if (popup) {
        popup.remove();
        actionContainer?.querySelector<HTMLButtonElement>('[data-graph-action="settings"]')?.focus();
        return;
      }
      if (container?.classList.contains('slsg-is-fullscreen')) {
        toggleFullscreen(false);
        actionContainer?.querySelector<HTMLButtonElement>('[data-graph-action="fullscreen"]')?.focus();
      }
    });

    if (typeof MutationObserver !== 'undefined') {
      const themeObs = new MutationObserver(() => requestDraw());
      themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
    if (typeof ResizeObserver !== 'undefined' && container) {
      const resizeObs = new ResizeObserver(() => requestDraw());
      resizeObs.observe(container);
    }

    class Transform2D {
      x: number; y: number; k: number;
      constructor(k = 1, x = 0, y = 0) { this.k = k; this.x = x; this.y = y; }
      translate(dx = 0, dy = 0) { return new Transform2D(this.k, this.x + dx, this.y + dy); }
    }

    (gc as any).isFullscreen = false;
    (gc as any).config = (gc as any).config || {};
    (gc as any).config.depth = currentDepth;
    (gc as any).config.renderArrows = renderArrows;
    (gc as any).full_refresh = () => {
      buildSubgraph((gc as any).config.depth);
    };
    (gc as any).simulator = {
      get nodes() { return nodes; },
      userZoomed: false,
      centerTransform: new Transform2D(1, 0, 0),
      zoomTransform: new Transform2D(1, 0, 0),
      renderer: { resetZoom: () => autoFit() },
      updateZoom: (k: number, x: number, y: number) => {
        scale = k;
        if (Number.isFinite(x)) panX = x;
        if (Number.isFinite(y)) panY = y;
        requestDraw();
      },
      requestRender: true,
    };

    buildSubgraph(currentDepth);

    host.querySelectorAll<HTMLButtonElement>('[data-depth]').forEach(chip => {
      chip.onclick = () => setDepth(Number(chip.dataset.depth));
    });
  }

  const bound = new WeakSet<HTMLElement>();
  function bindGraphs() {
    for (const host of document.querySelectorAll<HTMLElement>('[data-note-graph]')) {
      if (bound.has(host)) continue;
      bound.add(host);
      const button = host.querySelector<HTMLButtonElement>('[data-load-graph]')!;
      const status = host.querySelector<HTMLElement>('[data-graph-status]')!;
      let pending = false;

      // Quick depth selector chips
      if (typeof host.querySelectorAll === 'function') {
        host.querySelectorAll<HTMLButtonElement>('[data-depth]').forEach(chip => {
          chip.addEventListener('click', () => {
            host.querySelectorAll('[data-depth]').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            const depth = Number(chip.dataset.depth);
            const g = host.querySelector('graph-component') as any;
            if (g && g.config) {
              g.config.depth = depth;
              g.full_refresh?.();
              setTimeout(() => fitGraph(g), 800);
            } else if (button && !button.hidden) {
              button.click();
            }
          });
        });
      }

      button.addEventListener('click', async () => {
        if (pending) return;
        pending = true;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        status.textContent = 'در حال بارگذاری گراف…';
        try {
          const { GraphComponent } = await import('../../node_modules/starlight-site-graph/components/graph/graph-component');
          if (!host.isConnected) return;
          host.append(host.querySelector<HTMLTemplateElement>('[data-graph-template]')!.content.cloneNode(true));
          init2DGraphEngine(host);
          if (!host.querySelector('.graph-canvas-2d')) {
            if (!customElements.get('graph-component')) customElements.define('graph-component', GraphComponent);
            nameGraph(host.querySelector<HTMLElement>('graph-component')!);
          }

          button.hidden = true;
          status.textContent = '';
        } catch {
          button.hidden = false;
          button.textContent = 'تلاش مجدد';
          status.textContent = 'بارگذاری گراف ناموفق بود؛ دوباره تلاش کنید. فهرست متنی پیوندها همچنان در دسترس است.';
        } finally {
          pending = false;
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });
      // Start the renderer automatically without blocking article rendering.
      button.hidden = true;
      setTimeout(() => button.click(), 0);
    }
  }
  bindGraphs();
  document.addEventListener('astro:page-load', bindGraphs);
</script>