---
import '../styles/graph.css';
import { noteHref } from '../lib/markdown.mjs';
import GraphWidget from './graph/GraphWidget';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const targetSlug = noteHref(slug).slice(1);
---
<GraphWidget slug={targetSlug} graphUrl="/api/graph.json" client:idle />
<noscript>
  <p class="text-xs text-muted-foreground mt-2">
    برای مشاهده گراف تعاملی دانش جاوااسکریپت را فعال کنید.
    <a href="/search" class="text-primary underline underline-offset-4">فهرست متنی یادداشت‌ها</a>
  </p>
</noscript>
