---
import {Plus,Folder,FileText,Search,X,ChevronsDown,ChevronsUp,ChevronLeft} from "lucide-react";
---
<section data-library-navigation class="library-navigation" aria-label="کتابخانه">
  <div class="library-heading">
    <span class="library-title">کتابخانه</span>
    <div class="library-toolbar-actions">
      <button type="button" data-library-expand aria-label="باز کردن همه پوشه‌ها" title="باز کردن همه پوشه‌ها"><ChevronsDown size={14} aria-hidden="true"/></button>
      <button type="button" data-library-collapse aria-label="بستن همه پوشه‌ها" title="بستن همه پوشه‌ها"><ChevronsUp size={14} aria-hidden="true"/></button>
      <button type="button" data-library-add hidden aria-label="ساخت یادداشت یا پوشه" title="ساخت یادداشت یا پوشه"><Plus size={15} aria-hidden="true"/></button>
    </div>
  </div>
  <div class="library-filter-container">
    <Search size={13} aria-hidden="true" className="library-filter-icon" />
    <input type="search" data-library-filter placeholder="فیلتر سریع یادداشت‌ها…" aria-label="فیلتر سریع در یادداشت‌ها" autocomplete="off" />
    <button type="button" data-library-filter-clear class="library-filter-clear" aria-label="پاک کردن فیلتر" title="پاک کردن فیلتر" hidden><X size={12} aria-hidden="true"/></button>
  </div>
  <nav class="workspace-library" aria-label="فایل‌ها و پوشه‌ها">
    <div class="folder-tree" data-library-tree></div>
    <p role="status" data-library-status></p>
  </nav>
  <dialog data-library-create aria-labelledby="library-create-title">
    <h2 id="library-create-title" data-create-heading>ساختن در کتابخانه</h2><p data-create-location></p>
    <form>
      <label>نوع<select name="kind"><option value="note">یادداشت</option><option value="folder">پوشه</option></select></label>
      <label>نام<input name="title" required maxlength="255" autocomplete="off" autofocus/></label>
      <p role="status" data-create-status></p>
      <div class="garden-row"><button type="button" data-create-cancel>انصراف</button><button type="submit">ساختن</button></div>
    </form>
  </dialog>
  <template data-tree-icon="note"><FileText size={14} aria-hidden="true" className="tree-note-icon"/></template>
  <template data-tree-icon="folder"><Folder size={14} aria-hidden="true" className="tree-folder-icon"/></template>
  <template data-tree-icon="caret"><ChevronLeft size={13} aria-hidden="true" className="tree-caret"/></template>
</section>
<script>import "../scripts/library-navigation";</script>
<style>
.library-navigation{display:flex;flex-direction:column;min-height:0;flex:1;min-width:0;max-width:100%}
.library-heading{display:flex;align-items:center;justify-content:space-between;padding:4px 2px 6px;border-block-start:1px solid var(--border);margin-block-start:8px}
.library-title{font-weight:600;font-size:0.85rem;color:var(--muted-foreground);letter-spacing:-0.01em}
.library-toolbar-actions{display:flex;align-items:center;gap:3px}
.library-toolbar-actions button{width:26px;height:26px;padding:0;display:inline-flex;align-items:center;justify-content:center;border-radius:5px;border:1px solid transparent;background:transparent;color:var(--muted-foreground);cursor:pointer;transition:background-color .15s ease, color .15s ease}
.library-toolbar-actions button[hidden],.library-filter-clear[hidden]{display:none}
.library-toolbar-actions button:hover{background:var(--surface-hover);color:var(--foreground)}
.library-toolbar-actions button:focus-visible{outline:2px solid var(--ring);outline-offset:1px;box-shadow:none}
.library-filter-container{position:relative;margin:4px 0 8px;display:flex;align-items:center;min-width:0}
:global(.library-filter-icon){position:absolute;inset-inline-start:9px;top:50%;transform:translateY(-50%);color:var(--muted-foreground);pointer-events:none}
.library-filter-container input{width:100%;height:32px;padding:4px 28px;font-size:0.78rem;border:1px solid var(--border);border-radius:6px;background:var(--surface-subtle);color:inherit;outline:none;transition:border-color .15s ease,background-color .15s ease}
.library-filter-container input::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none}
.library-filter-container input:focus{border-color:var(--primary);background:var(--background)}
.library-filter-container input::placeholder{color:var(--muted-foreground);opacity:0.8}
.library-filter-clear{position:absolute;inset-inline-end:5px;top:50%;transform:translateY(-50%);width:22px;height:22px;padding:0;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:4px;background:transparent;color:var(--muted-foreground);cursor:pointer}
.library-filter-clear:hover{background:var(--surface-hover);color:var(--foreground)}
:global([data-library-tree] .library-filter-mark){background:var(--selection);color:var(--foreground);border-radius:2px;padding-inline:1px}
:global([data-library-tree] .library-empty-state){margin:10px 4px;padding:12px 10px;border:1px dashed var(--border);border-radius:8px;text-align:center;font-size:0.78rem;color:var(--muted-foreground)}
:global([data-library-tree]){min-width:0;width:100%}
:global([data-library-tree] details){width:100%;max-width:100%;min-width:0}
:global([data-library-tree] summary){width:100%;max-width:100%;min-width:0;min-height:30px;padding:4px 6px;border-radius:6px;display:flex;align-items:center;gap:6px;cursor:pointer;user-select:none;list-style:none;transition:background-color .15s ease,color .15s ease}
:global([data-library-tree] summary::-webkit-details-marker){display:none}
:global([data-library-tree] summary::marker){display:none;content:''}
:global([data-library-tree] summary>span:not(.tree-badge)){min-width:0;flex:1 1 0%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.84rem;font-weight:500}
:global([data-library-tree] summary svg){flex-shrink:0}
:global([data-library-tree] .tree-caret){transition:transform .2s ease;color:var(--muted-foreground);flex-shrink:0}
:global([data-library-tree] details[open] > summary > .tree-caret){transform:rotate(-90deg)}
:global([data-library-tree] .tree-badge){flex:0 0 auto;width:auto;font-size:0.68rem;padding:1px 6px;border-radius:9999px;background:var(--surface-hover);color:var(--muted-foreground);font-variant-numeric:tabular-nums;margin-inline-start:auto;line-height:1.3}
:global([data-library-tree] .tree-folder-icon){color:var(--muted-foreground);opacity:0.85}
:global([data-library-tree] .tree-note-icon){color:var(--muted-foreground);opacity:0.75}
:global([data-library-tree] a){width:100%;max-width:100%;min-width:0;min-height:28px;padding:3px 6px;border-radius:6px;display:flex;align-items:center;gap:6px;font-size:0.825rem;color:var(--muted-foreground);text-decoration:none;transition:background-color .15s ease, color .15s ease}
:global([data-library-tree] a>span){min-width:0;flex:1 1 0%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
:global([data-library-tree] a:hover),:global([data-library-tree] summary:hover){background:var(--surface-hover);color:var(--foreground)}
:global([data-library-tree] a[aria-current="page"]){background:var(--primary-soft);color:var(--primary-text);font-weight:600}
:global([data-library-tree] .library-child-add){margin-inline-start:auto;width:22px;height:22px;border-radius:4px;border:0;background:transparent;color:var(--muted-foreground);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
:global([data-library-tree] .library-child-add:hover){background:var(--surface-active);color:var(--foreground)}
:global([data-library-tree] details > .folder-tree){padding-inline-start:10px;margin-inline-start:5px;border-inline-start:1px solid var(--border)}
[data-library-status]:empty{display:none}[data-library-status]{font-size:12px;padding-inline:12px}
dialog{width:min(420px,calc(100vw - 32px));padding:24px;border:1px solid var(--border);border-radius:10px;background:var(--popover);color:var(--popover-foreground)}
dialog::backdrop{background:oklch(0 0 0 / 0.45)}dialog h2{font-size:20px;margin:0}dialog label{display:grid;gap:6px;margin-block:16px}dialog input,dialog select{width:100%;min-height:44px;background:var(--surface-subtle);color:inherit;border:1px solid var(--border);border-radius:6px;padding:8px}dialog button{min-height:44px}dialog button[type=submit]{background:var(--primary);color:var(--primary-foreground);border-radius:6px;border:0;font-weight:600}dialog p{font-size:13px}dialog .garden-row{justify-content:flex-end}
</style>
