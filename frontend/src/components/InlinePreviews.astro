---
import { UMKO_KINDS } from '../lib/umko.mjs';

const kindMeta = Object.fromEntries(
  Object.entries(UMKO_KINDS as Record<string, { label: string; color: string }>).map(
    ([key, val]) => [key, { label: val.label, color: val.color }],
  ),
);
---

<aside
  id="inline-note-preview"
  class="inline-note-preview"
  popover="auto"
  role="dialog"
  aria-label="پیش‌نمایش مقصد"
  tabindex="-1"
>
</aside>
<script type="application/json" data-preview-kinds set:html={JSON.stringify(kindMeta)} />

<script>
  const popup = document.querySelector<HTMLElement>('#inline-note-preview');
  const mainEl = document.querySelector<HTMLElement>('#main');
  const kindsRaw =
    document.querySelector<HTMLScriptElement>('[data-preview-kinds]')?.textContent || '{}';
  let kindMap: Record<string, { label: string; color: string }> = {};
  try {
    kindMap = JSON.parse(kindsRaw);
  } catch {}

  if (popup && mainEl) {
    type PreviewData = {
      slug: string;
      title: string;
      href: string;
      kind?: string;
      slogan?: string;
      html?: string;
    };

    const isTouchPrimary = () =>
      window.matchMedia('(pointer: coarse)').matches && !window.matchMedia('(pointer: fine)').matches;

    const cache = new Map<string, PreviewData>();
    let activeAnchor: HTMLAnchorElement | null = null;
    let activeSlug = '';
    let isPinned = false;
    let togglingPin = false;
    let openTimer: ReturnType<typeof setTimeout> | undefined;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let fetchController: AbortController | undefined;
    let hoverToken = 0;

    const PIN_SVG =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg>';
    const CLOSE_SVG =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';

    function isOpen(): boolean {
      try {
        if (popup!.matches(':popover-open')) return true;
      } catch {}
      return popup!.classList.contains('is-open');
    }

    function openPopover() {
      popup!.classList.add('is-open');
      if (typeof popup!.showPopover === 'function') {
        try {
          if (!popup!.matches(':popover-open')) popup!.showPopover();
        } catch {}
      }
    }

    function closePopover() {
      popup!.classList.remove('is-open');
      if (typeof popup!.hidePopover === 'function') {
        try {
          if (popup!.matches(':popover-open')) popup!.hidePopover();
        } catch {}
      }
    }

    function buildHeader(titleText: string, href: string, kind?: string) {
      const header = document.createElement('header');
      header.className = 'inline-preview-header';

      const headingGroup = document.createElement('div');
      headingGroup.className = 'inline-preview-title-wrap';

      const meta = kind ? kindMap[kind] : undefined;
      if (meta) {
        const badge = document.createElement('span');
        badge.className = 'inline-preview-kind';
        badge.style.setProperty('--kind-color', meta.color);
        const dot = document.createElement('span');
        dot.className = 'inline-preview-kind-dot';
        dot.setAttribute('aria-hidden', 'true');
        badge.append(dot, document.createTextNode(meta.label));
        headingGroup.append(badge);
      }

      const link = document.createElement('a');
      link.className = 'inline-preview-title';
      link.href = href;
      link.textContent = titleText;
      headingGroup.append(link);

      const controls = document.createElement('div');
      controls.className = 'inline-preview-controls';

      const pinBtn = document.createElement('button');
      pinBtn.type = 'button';
      pinBtn.className = 'inline-preview-btn';
      pinBtn.dataset.previewPin = '';
      pinBtn.setAttribute('aria-pressed', String(isPinned));
      pinBtn.setAttribute('aria-label', isPinned ? 'رها کردن پیش‌نمایش' : 'سنجاق کردن پیش‌نمایش');
      pinBtn.title = isPinned ? 'رها کردن' : 'سنجاق کردن';
      pinBtn.innerHTML = PIN_SVG;
      pinBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        isPinned = !isPinned;
        pinBtn.setAttribute('aria-pressed', String(isPinned));
        pinBtn.setAttribute('aria-label', isPinned ? 'رها کردن پیش‌نمایش' : 'سنجاق کردن پیش‌نمایش');
        pinBtn.title = isPinned ? 'رها کردن' : 'سنجاق کردن';

        togglingPin = true;
        try {
          const wasOpen = isOpen();
          if (wasOpen) closePopover();
          popup!.setAttribute('popover', isPinned ? 'manual' : 'auto');
          if (wasOpen) {
            openPopover();
            if (activeAnchor) positionPopup(activeAnchor);
          }
        } finally {
          togglingPin = false;
        }
      });

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'inline-preview-btn';
      closeBtn.dataset.previewClose = '';
      closeBtn.setAttribute('aria-label', 'بستن پیش‌نمایش');
      closeBtn.title = 'بستن';
      closeBtn.innerHTML = CLOSE_SVG;
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        hidePreview(true);
      });

      controls.append(pinBtn, closeBtn);
      header.append(headingGroup, controls);
      return header;
    }

    function positionPopup(anchor: HTMLElement) {
      if (!isOpen() || !anchor.isConnected) return;
      const rect = anchor.getBoundingClientRect();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const pad = 12;
      const gap = 8;
      const topSafe = 64;

      const measuredW = Math.min(440, vw - pad * 2);
      popup!.style.width = `${measuredW}px`;

      let left = rect.left;
      if (document.documentElement.dir === 'rtl') {
        left = rect.right - measuredW;
      }
      left = Math.max(pad, Math.min(vw - measuredW - pad, left));
      popup!.style.left = `${left}px`;
      popup!.style.right = 'auto';

      const spaceBelow = vh - rect.bottom - gap - pad;
      const spaceAbove = rect.top - topSafe - gap;
      const naturalHeight = Math.min(360, popup!.scrollHeight || 220);

      let top: number;
      let maxH: number;
      if (spaceBelow >= Math.min(naturalHeight, 190) || spaceBelow >= spaceAbove) {
        top = rect.bottom + gap;
        maxH = Math.max(120, Math.min(360, spaceBelow));
      } else {
        maxH = Math.max(120, Math.min(360, spaceAbove));
        const usedH = Math.min(naturalHeight, maxH);
        top = Math.max(topSafe, rect.top - gap - usedH);
      }
      popup!.style.maxHeight = `${maxH}px`;
      popup!.style.top = `${top}px`;
    }

    function renderSkeleton(anchor: HTMLAnchorElement) {
      const skeleton = document.createElement('div');
      skeleton.className = 'inline-preview-skeleton';
      skeleton.innerHTML =
        '<div class="sk-line sk-w60"></div><div class="sk-line sk-w95"></div><div class="sk-line sk-w80"></div>';
      popup!.replaceChildren(
        buildHeader(anchor.textContent?.trim() || 'در حال بارگذاری…', anchor.href),
        skeleton,
      );
      openPopover();
      positionPopup(anchor);
    }

    function renderContent(anchor: HTMLAnchorElement, data: PreviewData) {
      const body = document.createElement('div');
      body.className = 'inline-preview-body note';
      if (data.slogan) {
        const slogan = document.createElement('p');
        slogan.className = 'inline-preview-slogan';
        slogan.textContent = data.slogan;
        body.append(slogan);
      }
      if (data.html) {
        const content = document.createElement('div');
        content.className = 'inline-preview-html';
        content.innerHTML = data.html;
        body.append(content);
      } else if (!data.slogan) {
        const empty = document.createElement('p');
        empty.className = 'inline-preview-empty';
        empty.textContent = 'پیش‌نمایشی برای این یادداشت ثبت نشده است.';
        body.append(empty);
      }
      popup!.replaceChildren(
        buildHeader(
          data.title || anchor.textContent?.trim() || '',
          data.href || anchor.href,
          data.kind,
        ),
        body,
      );
      openPopover();
      requestAnimationFrame(() => positionPopup(anchor));
    }

    function resetState() {
      isPinned = false;
      activeAnchor = null;
      activeSlug = '';
      if (popup!.getAttribute('popover') !== 'auto') {
        popup!.setAttribute('popover', 'auto');
      }
      popup!.replaceChildren();
    }

    function hidePreview(force = false) {
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      if (!force && isPinned) return;
      fetchController?.abort();
      fetchController = undefined;
      closePopover();
      resetState();
    }

    function scheduleClose() {
      if (isPinned) return;
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => hidePreview(false), 180);
    }

    async function showForAnchor(anchor: HTMLAnchorElement, slug: string) {
      if (isPinned && activeSlug && activeSlug !== slug) return;
      const myToken = ++hoverToken;
      activeAnchor = anchor;
      activeSlug = slug;

      const cached = cache.get(slug);
      if (cached) {
        renderContent(anchor, cached);
        return;
      }

      fetchController?.abort();
      fetchController = new AbortController();
      renderSkeleton(anchor);

      try {
        const res = await fetch(`/api/note-preview/${encodeURIComponent(slug)}`, {
          credentials: 'same-origin',
          signal: fetchController.signal,
        });
        if (!res.ok) throw new Error('Preview unavailable');
        const data = (await res.json()) as PreviewData;
        cache.set(slug, data);
        if (myToken !== hoverToken || activeAnchor !== anchor) return;
        renderContent(anchor, data);
      } catch (err) {
        if ((err as Error)?.name === 'AbortError' || myToken !== hoverToken) return;
        const msg = document.createElement('p');
        msg.className = 'inline-preview-empty';
        msg.textContent = 'دریافت پیش‌نمایش ممکن نشد.';
        popup!.replaceChildren(buildHeader(anchor.textContent?.trim() || '', anchor.href), msg);
        openPopover();
        requestAnimationFrame(() => positionPopup(anchor));
      }
    }

    popup.addEventListener('toggle', (event) => {
      if (togglingPin) return;
      if ((event as ToggleEvent).newState === 'closed') {
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
        fetchController?.abort();
        fetchController = undefined;
        popup!.classList.remove('is-open');
        resetState();
      }
    });

    mainEl.addEventListener('mouseover', (event) => {
      if (isTouchPrimary()) return;
      const anchor = (event.target as Element)?.closest<HTMLAnchorElement>('a[data-note-preview]');
      if (!anchor || anchor.closest('#inline-note-preview')) return;
      const slug = anchor.dataset.notePreview;
      if (!slug) return;
      clearTimeout(closeTimer);
      if (activeAnchor === anchor && isOpen()) return;
      clearTimeout(openTimer);
      const delay = cache.has(slug) ? 140 : 240;
      openTimer = setTimeout(() => void showForAnchor(anchor, slug), delay);
    });

    mainEl.addEventListener('mouseout', (event) => {
      const anchor = (event.target as Element)?.closest<HTMLAnchorElement>('a[data-note-preview]');
      if (!anchor) return;
      const to = event.relatedTarget as Node | null;
      if (to && (anchor.contains(to) || popup.contains(to))) return;
      scheduleClose();
    });

    mainEl.addEventListener('focusin', (event) => {
      if (isTouchPrimary()) return;
      const anchor = (event.target as Element)?.closest<HTMLAnchorElement>('a[data-note-preview]');
      if (!anchor || anchor.closest('#inline-note-preview')) return;
      const slug = anchor.dataset.notePreview;
      if (!slug) return;
      clearTimeout(closeTimer);
      clearTimeout(openTimer);
      openTimer = setTimeout(() => void showForAnchor(anchor, slug), 320);
    });

    mainEl.addEventListener('focusout', (event) => {
      const anchor = (event.target as Element)?.closest<HTMLAnchorElement>('a[data-note-preview]');
      if (!anchor) return;
      const to = event.relatedTarget as Node | null;
      if (to && popup.contains(to)) return;
      scheduleClose();
    });

    popup.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    popup.addEventListener('mouseleave', (event) => {
      const to = event.relatedTarget as Node | null;
      if (to && activeAnchor?.contains(to)) return;
      scheduleClose();
    });

    window.addEventListener(
      'scroll',
      () => {
        if (isOpen() && activeAnchor) positionPopup(activeAnchor);
      },
      { passive: true },
    );

    window.addEventListener(
      'resize',
      () => {
        if (isOpen() && activeAnchor) positionPopup(activeAnchor);
      },
      { passive: true },
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        const returnFocusTo = activeAnchor;
        hidePreview(true);
        returnFocusTo?.focus({ preventScroll: true });
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (!isOpen() || isPinned) return;
      const target = event.target as Node;
      if (!popup.contains(target) && !(activeAnchor && activeAnchor.contains(target))) {
        hidePreview(true);
      }
    });
  }
</script>

<style is:global>
  .inline-note-preview {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0;
    z-index: 65;
    width: min(440px, calc(100vw - 24px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: 0 20px 44px -8px oklch(0 0 0 / 0.28);
  }

  .inline-note-preview:not(:popover-open):not(.is-open) {
    display: none;
  }

  .inline-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-subtle);
  }

  .inline-preview-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }

  .inline-preview-kind {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    padding: 1px 7px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    background: color-mix(in oklch, var(--kind-color) 14%, var(--surface));
    border: 1px solid color-mix(in oklch, var(--kind-color) 32%, var(--border));
    color: var(--foreground);
  }

  .inline-preview-kind-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--kind-color);
  }

  .inline-preview-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
  }

  .inline-preview-title:hover {
    color: var(--primary-text);
    text-decoration: underline;
  }

  .inline-preview-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .inline-preview-btn {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .inline-preview-btn:hover {
    background: var(--surface-hover);
    color: var(--foreground);
  }

  .inline-preview-btn[aria-pressed='true'] {
    background: var(--primary-soft);
    color: var(--primary-text);
  }

  .inline-preview-body {
    overflow-y: auto;
    padding: 10px 14px 12px;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .inline-preview-slogan {
    margin: 0 0 8px;
    font-size: 0.82rem;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
  }

  .inline-preview-html > :first-child {
    margin-block-start: 0;
  }

  .inline-preview-html > :last-child {
    margin-block-end: 0;
  }

  .inline-preview-empty {
    margin: 6px 0;
    padding: 8px 12px;
    font-size: 12.5px;
    color: var(--muted-foreground);
  }

  .inline-preview-skeleton {
    padding: 14px;
    display: grid;
    gap: 8px;
  }

  .inline-preview-skeleton .sk-line {
    height: 11px;
    border-radius: 6px;
    background: var(--surface-hover);
    animation: preview-pulse 1.2s ease-in-out infinite;
  }

  .inline-preview-skeleton .sk-w60 {
    width: 60%;
  }
  .inline-preview-skeleton .sk-w95 {
    width: 95%;
  }
  .inline-preview-skeleton .sk-w80 {
    width: 80%;
  }

  @keyframes preview-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.9;
    }
  }
</style>
