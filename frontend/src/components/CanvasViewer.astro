<script>
  import { escapeHtml, safeExternalUrl } from '../lib/canvas-sanitize.mjs';

  const activeCanvas = new WeakSet<HTMLElement>();
  let canvasMarkerSeq = 0;

  const OBSIDIAN_COLORS: Record<string, string> = {
    '1': '#e93535',
    '2': '#ec7500',
    '3': '#e0ac00',
    '4': '#08b94e',
    '5': '#00bfbc',
    '6': '#7852ee',
  };

  const FILE_ICON_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>';
  const LINK_ICON_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';

  interface CanvasNode {
    id: string;
    type: 'text' | 'file' | 'link' | 'group';
    x: number;
    y: number;
    width: number;
    height: number;
    color?: string;
    text?: string;
    file?: string;
    subpath?: string;
    url?: string;
    label?: string;
  }

  interface CanvasEdge {
    id: string;
    fromNode: string;
    fromSide?: 'top' | 'right' | 'bottom' | 'left';
    toNode: string;
    toSide?: 'top' | 'right' | 'bottom' | 'left';
    label?: string;
    color?: string;
    toEnd?: string;
  }

  interface CanvasData {
    nodes: CanvasNode[];
    edges: CanvasEdge[];
  }

  function getSideCoords(node: CanvasNode, side?: string): [number, number] {
    const cx = node.x + node.width / 2;
    const cy = node.y + node.height / 2;
    switch (side) {
      case 'top':
        return [cx, node.y];
      case 'bottom':
        return [cx, node.y + node.height];
      case 'left':
        return [node.x, cy];
      case 'right':
        return [node.x + node.width, cy];
      default:
        return [node.x + node.width, cy];
    }
  }

  function getControlPoint(x: number, y: number, side?: string, dist = 50): [number, number] {
    switch (side) {
      case 'top':
        return [x, y - dist];
      case 'bottom':
        return [x, y + dist];
      case 'left':
        return [x - dist, y];
      case 'right':
        return [x + dist, y];
      default:
        return [x + dist, y];
    }
  }

  async function mountCanvas(container: HTMLElement) {
    if (activeCanvas.has(container)) return;
    activeCanvas.add(container);

    try {
      let data: CanvasData;
      if (container.dataset.canvasData) {
        data = JSON.parse(decodeURIComponent(container.dataset.canvasData));
      } else {
        const url = container.dataset.canvasUrl;
        if (!url) return;
        const res = await fetch(url);
        if (!res.ok) throw new Error('Failed to load canvas');
        const json = await res.json();
        data = json && typeof json.content === 'string' ? JSON.parse(json.content) : json;
      }
      if (!Array.isArray(data.nodes)) throw new Error('Invalid canvas format');

      renderCanvasBoard(container, data);
    } catch {
      const errWrap = document.createElement('div');
      errWrap.className = 'canvas-error';
      errWrap.setAttribute('role', 'alert');
      const errP = document.createElement('p');
      errP.append('بارگذاری بوم ابسیدین امکان‌پذیر نشد. پیوند فایل: ');
      const errLink = document.createElement('a');
      errLink.href = safeExternalUrl(container.dataset.canvasUrl) || '#';
      errLink.textContent = container.dataset.canvasTitle || 'فایل بوم';
      errP.append(errLink);
      errWrap.append(errP);
      container.replaceChildren(errWrap);
    }
  }

  function renderCanvasBoard(container: HTMLElement, data: CanvasData) {
    const { nodes, edges = [] } = data;
    if (nodes.length === 0) {
      container.innerHTML = '<div class="canvas-empty"><p>این بوم خالی است.</p></div>';
      return;
    }

    let minX = Infinity,
      minY = Infinity,
      maxX = -Infinity,
      maxY = -Infinity;
    for (const n of nodes) {
      minX = Math.min(minX, n.x);
      minY = Math.min(minY, n.y);
      maxX = Math.max(maxX, n.x + n.width);
      maxY = Math.max(maxY, n.y + n.height);
    }

    const padding = 80;
    minX -= padding;
    minY -= padding;
    maxX += padding;
    maxY += padding;
    const boardWidth = maxX - minX;
    const boardHeight = maxY - minY;
    const arrowId = `canvas-arrow-${++canvasMarkerSeq}`;

    container.innerHTML = `
      <div class="canvas-toolbar" role="toolbar" aria-label="ابزارهای بوم">
        <span class="canvas-title-label">${escapeHtml(container.dataset.canvasTitle || 'بوم ابسیدین')}</span>
        <div class="canvas-actions">
          <button type="button" data-act="zoom-in" title="بزرگ‌نمایی">+</button>
          <button type="button" data-act="reset" title="اندازه طبیعی">۱۰۰٪</button>
          <button type="button" data-act="zoom-out" title="کوچک‌نمایی">−</button>
          <button type="button" data-act="fit" title="تراز کل بوم">تراز</button>
          <button type="button" data-act="fullscreen" title="تمام‌صفحه">تمام‌صفحه</button>
        </div>
      </div>
      <div class="canvas-viewport" tabindex="0" role="region" aria-label="فضای بوم">
        <div class="canvas-stage" style="width: ${boardWidth}px; height: ${boardHeight}px;">
          <svg class="canvas-edges-layer" width="${boardWidth}" height="${boardHeight}">
            <defs>
              <marker id="${arrowId}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="currentColor"/>
              </marker>
            </defs>
          </svg>
          <div class="canvas-nodes-layer"></div>
        </div>
        <span class="canvas-hint" aria-hidden="true">برای جابه‌جایی بکشید · برای زوم Ctrl + اسکرول</span>
      </div>
    `;

    const stage = container.querySelector<HTMLElement>('.canvas-stage')!;
    const viewport = container.querySelector<HTMLElement>('.canvas-viewport')!;
    const svgLayer = container.querySelector<SVGElement>('.canvas-edges-layer')!;
    const nodesLayer = container.querySelector<HTMLElement>('.canvas-nodes-layer')!;

    const nodeMap = new Map<string, CanvasNode>();
    for (const n of nodes) {
      nodeMap.set(n.id, n);
      const nodeEl = document.createElement('div');
      nodeEl.className = `canvas-node canvas-node-${n.type}`;
      nodeEl.style.left = `${n.x - minX}px`;
      nodeEl.style.top = `${n.y - minY}px`;
      nodeEl.style.width = `${n.width}px`;
      nodeEl.style.height = `${n.height}px`;

      if (n.color) {
        const hex = OBSIDIAN_COLORS[n.color] || n.color;
        nodeEl.style.borderColor = hex;
      }

      if (n.type === 'text') {
        const contentDiv = document.createElement('div');
        contentDiv.className = 'canvas-node-content';
        const p = document.createElement('p');
        const textLines = String(n.text || '').split('\n');
        textLines.forEach((line, idx) => {
          if (idx > 0) p.append(document.createElement('br'));
          p.append(document.createTextNode(line));
        });
        contentDiv.append(p);
        nodeEl.append(contentDiv);
      } else if (n.type === 'file') {
        const fileName = (n.file || '').split('/').pop()?.replace(/\.md$/, '') || 'یادداشت';
        const headerDiv = document.createElement('div');
        headerDiv.className = 'canvas-node-file-header';
        const iconSpan = document.createElement('span');
        iconSpan.className = 'canvas-file-icon';
        iconSpan.innerHTML = FILE_ICON_SVG;
        const titleSpan = document.createElement('span');
        titleSpan.className = 'canvas-file-title';
        titleSpan.title = String(n.file || '');
        titleSpan.textContent = fileName;
        headerDiv.append(iconSpan, titleSpan);

        const bodyDiv = document.createElement('div');
        bodyDiv.className = 'canvas-node-file-body';
        const link = document.createElement('a');
        link.href = `/notes/${encodeURIComponent(fileName)}`;
        link.className = 'canvas-open-link';
        link.textContent = 'مشاهدهٔ یادداشت';
        bodyDiv.append(link);
        nodeEl.append(headerDiv, bodyDiv);
      } else if (n.type === 'link') {
        const linkDiv = document.createElement('div');
        linkDiv.className = 'canvas-node-link-content';
        const iconSpan = document.createElement('span');
        iconSpan.className = 'canvas-link-icon';
        iconSpan.innerHTML = LINK_ICON_SVG;
        const validated = safeExternalUrl(n.url);
        if (validated) {
          const anchor = document.createElement('a');
          anchor.href = validated;
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
          anchor.textContent = validated;
          linkDiv.append(iconSpan, anchor);
        } else {
          const span = document.createElement('span');
          span.textContent = String(n.url || 'پیوند نامعتبر');
          linkDiv.append(iconSpan, span);
        }
        nodeEl.append(linkDiv);
      } else if (n.type === 'group') {
        const labelSpan = document.createElement('span');
        labelSpan.className = 'canvas-group-label';
        labelSpan.textContent = String(n.label || '');
        nodeEl.append(labelSpan);
      }

      nodesLayer.appendChild(nodeEl);
    }

    for (const edge of edges) {
      const fromNode = nodeMap.get(edge.fromNode);
      const toNode = nodeMap.get(edge.toNode);
      if (!fromNode || !toNode) continue;

      const [x1, y1] = getSideCoords(fromNode, edge.fromSide);
      const [x2, y2] = getSideCoords(toNode, edge.toSide);
      const sx1 = x1 - minX,
        sy1 = y1 - minY;
      const sx2 = x2 - minX,
        sy2 = y2 - minY;

      const dist = Math.max(30, Math.hypot(sx2 - sx1, sy2 - sy1) / 3);
      const [c1x, c1y] = getControlPoint(sx1, sy1, edge.fromSide, dist);
      const [c2x, c2y] = getControlPoint(sx2, sy2, edge.toSide, dist);

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', `M ${sx1} ${sy1} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${sx2} ${sy2}`);
      path.setAttribute('class', 'canvas-edge-path');
      path.setAttribute('marker-end', `url(#${arrowId})`);

      if (edge.color) {
        const hex = OBSIDIAN_COLORS[edge.color] || edge.color;
        path.style.stroke = hex;
      }
      svgLayer.appendChild(path);

      if (edge.label) {
        const lx = 0.125 * sx1 + 0.375 * c1x + 0.375 * c2x + 0.125 * sx2;
        const ly = 0.125 * sy1 + 0.375 * c1y + 0.375 * c2y + 0.125 * sy2;
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', String(lx));
        text.setAttribute('y', String(ly));
        text.setAttribute('class', 'canvas-edge-label');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = edge.label;
        svgLayer.appendChild(text);
      }
    }

    let zoom = 1;
    let panX = 0;
    let panY = 0;

    function applyTransform() {
      stage.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
    }

    function fit() {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      if (vw && vh) {
        const scaleX = vw / boardWidth;
        const scaleY = vh / boardHeight;
        zoom = Math.min(1.2, Math.max(0.2, Math.min(scaleX, scaleY) * 0.9));
        panX = (vw - boardWidth * zoom) / 2;
        panY = (vh - boardHeight * zoom) / 2;
        applyTransform();
      }
    }

    fit();

    let activePointerId: number | null = null;
    let startX = 0;
    let startY = 0;

    viewport.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.canvas-node a, .canvas-node button')) return;
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      activePointerId = e.pointerId;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      viewport.setPointerCapture(e.pointerId);
      viewport.style.cursor = 'grabbing';
    });

    viewport.addEventListener('pointermove', (e) => {
      if (activePointerId !== e.pointerId) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      applyTransform();
    });

    const endDrag = (e: PointerEvent) => {
      if (activePointerId !== e.pointerId) return;
      activePointerId = null;
      if (viewport.hasPointerCapture(e.pointerId)) {
        viewport.releasePointerCapture(e.pointerId);
      }
      viewport.style.cursor = 'grab';
    };

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    viewport.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        const delta = e.deltaY > 0 ? 0.9 : 1.1;
        const newZoom = Math.min(2.5, Math.max(0.2, zoom * delta));
        const rect = viewport.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        panX = mouseX - (mouseX - panX) * (newZoom / zoom);
        panY = mouseY - (mouseY - panY) * (newZoom / zoom);
        zoom = newZoom;
        applyTransform();
      },
      { passive: false },
    );

    container.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
      if (!btn) return;
      const act = btn.dataset.act;
      if (act === 'zoom-in') {
        zoom = Math.min(2.5, zoom * 1.2);
        applyTransform();
      } else if (act === 'zoom-out') {
        zoom = Math.max(0.2, zoom / 1.2);
        applyTransform();
      } else if (act === 'reset') {
        zoom = 1;
        panX = (viewport.clientWidth - boardWidth) / 2;
        panY = (viewport.clientHeight - boardHeight) / 2;
        applyTransform();
      } else if (act === 'fit') {
        fit();
      } else if (act === 'fullscreen') {
        if (!document.fullscreenElement) {
          void container.requestFullscreen?.().catch(() => {});
        } else {
          void document.exitFullscreen?.().catch(() => {});
        }
      }
    });
  }

  function bind() {
    for (const container of document.querySelectorAll<HTMLElement>(
      '[data-canvas-url], .canvas-diagram',
    )) {
      if (!activeCanvas.has(container)) {
        void mountCanvas(container);
      }
    }
  }

  bind();
  new MutationObserver(bind).observe(document.body, { childList: true, subtree: true });
</script>
