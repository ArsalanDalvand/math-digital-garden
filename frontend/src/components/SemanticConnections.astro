---
import type { IndexedNote } from '../lib/markdown.mjs';
import { noteHref } from '../lib/markdown.mjs';
import { UMKO_KINDS, UMKO_RELATION_PLANES, UMKO_RELATIONS } from '../lib/umko.mjs';

interface Props {
  note: IndexedNote;
  bySlug: Map<string, IndexedNote>;
}

const { note, bySlug } = Astro.props;

type RelationEntry = {
  key: string;
  label: string;
  planeColor: string;
  nodes: Array<{ slug: string; title: string; kindLabel: string; kindColor: string }>;
};

const kinds = UMKO_KINDS as Record<string, { label: string; color: string }>;
const planes = UMKO_RELATION_PLANES as Record<string, { label: string; light: string }>;
const relations = UMKO_RELATIONS as Record<
  string,
  { forward: string; reverse: string; plane?: string }
>;

const entries: RelationEntry[] = [];

const resolveNodes = (slugs: string[]) =>
  slugs
    .map((s) => bySlug.get(s))
    .filter((n): n is IndexedNote => Boolean(n))
    .map((n) => {
      const k = n.kind ? kinds[n.kind] : undefined;
      return {
        slug: n.slug,
        title: n.title_fa || n.title,
        kindLabel: k?.label ?? '',
        kindColor: k?.color ?? 'var(--primary)',
      };
    });

for (const [relKey, slugs] of Object.entries(note.resolvedRelations || {})) {
  const def = relations[relKey];
  if (!def || !slugs.length) continue;
  const nodes = resolveNodes(slugs);
  if (!nodes.length) continue;
  const planeColor = (def.plane && planes[def.plane]?.light) || 'var(--primary)';
  entries.push({ key: `fwd-${relKey}`, label: def.forward, planeColor, nodes });
}

for (const [relKey, slugs] of Object.entries(note.reverseRelations || {})) {
  const def = relations[relKey];
  if (!def || !slugs.length) continue;
  const nodes = resolveNodes(slugs);
  if (!nodes.length) continue;
  const planeColor = (def.plane && planes[def.plane]?.light) || 'var(--primary)';
  entries.push({ key: `rev-${relKey}`, label: def.reverse, planeColor, nodes });
}
---

{entries.length > 0 && (
  <section class="semantic-connections" aria-label="روابط معنایی یادداشت">
    <h2 class="semantic-connections-title">روابط علمی این یادداشت</h2>
    <div class="semantic-groups">
      {entries.map((entry) => (
        <div class="semantic-group" style={`--plane-color: ${entry.planeColor}`}>
          <h3 class="semantic-group-heading">
            <span class="semantic-plane-dot" aria-hidden="true"></span>
            <span>{entry.label}</span>
          </h3>
          <ul class="semantic-node-list">
            {entry.nodes.map((node) => (
              <li>
                <a class="semantic-node-link" href={noteHref(node.slug)} data-note-preview={node.slug}>
                  {node.kindLabel && (
                    <span class="semantic-kind-pill" style={`--kind-color: ${node.kindColor}`}>
                      <span class="semantic-kind-dot" aria-hidden="true"></span>
                      <span>{node.kindLabel}</span>
                    </span>
                  )}
                  <span class="semantic-node-name">{node.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .semantic-connections {
    margin-block: 1.75rem 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface-subtle);
  }

  .semantic-connections-title {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .semantic-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.85rem;
  }

  .semantic-group {
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-control);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .semantic-group-heading {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }

  .semantic-plane-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--plane-color);
    flex-shrink: 0;
  }

  .semantic-node-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .semantic-node-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.35rem 0.45rem;
    border-radius: 6px;
    color: var(--foreground);
    text-decoration: none;
    font-size: 0.85rem;
    line-height: 1.5;
    transition: background-color 120ms ease;
  }

  .semantic-node-link:hover {
    background: var(--surface-hover);
  }

  .semantic-node-name {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--primary-text);
    font-weight: 500;
  }

  .semantic-kind-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 6px;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    background: color-mix(in oklch, var(--kind-color) 11%, var(--surface-subtle));
    border: 1px solid color-mix(in oklch, var(--kind-color) 28%, var(--border));
    color: var(--foreground);
    white-space: nowrap;
  }

  .semantic-kind-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--kind-color);
  }
</style>
