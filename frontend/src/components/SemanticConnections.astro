---
import { noteHref } from '../lib/markdown.mjs';
import { UMKO_RELATIONS } from '../lib/umko.mjs';

type Note = {
  slug: string;
  title: string;
  kind?: string;
  resolvedRelations?: Record<string, string[]>;
  reverseRelations?: Record<string, string[]>;
};

interface Props {
  note: Note;
  garden?: Note[];
  bySlug?: Map<string, Note>;
}

const { note, garden = [], bySlug } = Astro.props;
if (!note) return;
const resolveNote = (s: string) => bySlug?.get(s) ?? garden.find(n => n.slug === s);
const relationsMap: Record<string, { forward?: string; reverse?: string; icon?: string }> = UMKO_RELATIONS;

const forward = Object.entries(note.resolvedRelations || {}).filter(([_, slugs]) => slugs.length > 0);
const reverse = Object.entries(note.reverseRelations || {}).filter(([_, slugs]) => slugs.length > 0);
const hasRelations = forward.length > 0 || reverse.length > 0;
---

{hasRelations && (
  <div class="semantic-connections-panel">
    <h3 class="semantic-header">شبکهٔ مفهومی و روابط ساختاری (UMKO v1.1)</h3>
    <div class="semantic-groups">
      {forward.map(([relKey, slugs]) => {
        const info = relationsMap[relKey] || { forward: relKey, icon: '🔗' };
        const relNotes = slugs.map(resolveNote).filter(Boolean);
        return (
          <div class="semantic-group">
            <h4 class="semantic-group-title">
              <span class="rel-icon" aria-hidden="true">{info.icon}</span>
              {info.forward}
              <span class="rel-count">({relNotes.length.toLocaleString('fa-IR')})</span>
            </h4>
            <ul class="semantic-link-list">
              {relNotes.map(rn => rn && (
                <li>
                  <a class="semantic-link" href={noteHref(rn.slug)}>
                    {rn.title}
                    {rn.kind && <span class="semantic-link-kind">[{rn.kind}]</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}

      {reverse.map(([relKey, slugs]) => {
        const info = relationsMap[relKey] || { reverse: relKey, icon: '🔗' };
        const relNotes = slugs.map(resolveNote).filter(Boolean);
        return (
          <div class="semantic-group semantic-group-reverse">
            <h4 class="semantic-group-title">
              <span class="rel-icon" aria-hidden="true">{info.icon}</span>
              {info.reverse}
              <span class="rel-count">({relNotes.length.toLocaleString('fa-IR')})</span>
            </h4>
            <ul class="semantic-link-list">
              {relNotes.map(rn => rn && (
                <li>
                  <a class="semantic-link" href={noteHref(rn.slug)}>
                    {rn.title}
                    {rn.kind && <span class="semantic-link-kind">[{rn.kind}]</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
)}

<style>
  .semantic-connections-panel {
    margin-block: var(--space-6) var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }
  .semantic-header {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    margin-block: 0 var(--space-3);
  }
  .semantic-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .semantic-group {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem;
  }
  .semantic-group-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-text);
    margin: 0 0 0.5rem 0;
  }
  .rel-count {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  .semantic-link-list {
    list-style: none;
    padding: 0 !important;
    margin: 0;
  }
  .semantic-link-list > li {
    margin-block-end: 0.35rem;
  }
  .semantic-link-list > li:last-child {
    margin-block-end: 0;
  }
  .semantic-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .semantic-link:hover {
    color: var(--primary-text);
    text-decoration: underline;
  }
  .semantic-link-kind {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
</style>
