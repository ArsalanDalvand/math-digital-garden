<button type="button" data-presentation-open hidden>حالت ارائه</button>
<dialog data-presentation aria-labelledby="presentation-title">
  <header><h2 id="presentation-title">حالت ارائه</h2><button type="button" data-presentation-close>بستن ارائه</button></header>
  <p role="status" aria-live="polite" data-presentation-status></p>
  <article class="note" data-presentation-stage tabindex="0" aria-label="اسلاید ارائه"></article>
  <footer><button type="button" data-presentation-prev>قبلی</button><span data-presentation-count aria-live="polite"></span><button type="button" data-presentation-next>بعدی</button><button type="button" data-presentation-fullscreen hidden>تمام‌صفحه</button><small>کلیدهای جهت، Home و End · خروج با Escape</small></footer>
</dialog>
<script>import '../scripts/presentation';</script>
<style is:global>
[data-presentation]{box-sizing:border-box;width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;margin:0;border:0;padding:1.5rem;background:var(--bg,#fff);color:var(--fg,#202020);overflow:hidden}
[data-presentation][open]{display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;gap:1rem}
[data-presentation]::backdrop{background:#000a}
[data-presentation] header,[data-presentation] footer{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
[data-presentation] header{grid-row:1;justify-content:space-between}
[data-presentation-status]{grid-row:2}
[data-presentation] footer{grid-row:4}
[data-presentation] header h2{font-size:1rem;margin:0}
[data-presentation] button{min-height:2.75rem;padding:.5rem 1rem}
[data-presentation] [data-presentation-stage]{grid-row:3;width:min(100%,70rem);max-width:100%;min-width:0;overflow:auto;overscroll-behavior:contain;margin:0 auto;padding:1rem;font-size:clamp(1rem,2.2vw,1.75rem);line-height:1.9;overflow-wrap:anywhere}
[data-presentation-stage] h1,[data-presentation-stage] h2{font-size:clamp(1.5rem,3.5vw,3rem);line-height:1.5}
[data-presentation-stage] img,[data-presentation-stage] iframe{max-width:100%}
[data-presentation-stage] pre,[data-presentation-stage] table{max-width:100%;overflow:auto}
[data-presentation] footer small{flex-basis:100%}
[data-presentation-status]:empty{display:none}
@media(max-width:600px){[data-presentation]{padding:.75rem;gap:.5rem}[data-presentation] [data-presentation-stage]{padding:.5rem}[data-presentation] footer{gap:.5rem}}
</style>
