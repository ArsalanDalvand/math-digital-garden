---
import {SlidersHorizontal} from 'lucide-react';
---
<details class="reading-settings"><summary aria-label="تنظیمات مطالعه" title="تنظیمات مطالعه"><SlidersHorizontal size={18} aria-hidden="true"/><span>تنظیمات مطالعه</span></summary><div class="reading-settings-panel"><strong>تنظیمات مطالعه</strong><label>اندازهٔ متن <input data-reading-setting="size" type="range" min="16" max="26" value="19" /></label><label>فاصلهٔ خطوط <input data-reading-setting="leading" type="range" min="1.5" max="2.5" step="0.1" value="2" /></label><label>عرض متن <select data-reading-setting="width"><option value="760">معمولی</option><option value="620">باریک</option><option value="960">عریض</option></select></label><label><input data-reading-setting="focus" type="checkbox" /> مطالعهٔ بدون سایدبار</label><button type="button" data-reading-reset>بازنشانی تنظیمات مطالعه</button><p data-reading-save-status role="status"></p></div></details>
<script>
const defaults={size:19,leading:2,width:760,focus:false};
let settings={...defaults};try{settings={...defaults,...JSON.parse(localStorage.getItem('garden-reading')??'{}')}}catch{}
function apply(save=false){const root=document.documentElement;root.style.setProperty('--reading-size',Math.max(16,Math.min(26,Number(settings.size)))+'px');root.style.setProperty('--reading-leading',Math.max(1.5,Math.min(2.5,Number(settings.leading))).toString());root.style.setProperty('--reading-width',Math.max(620,Math.min(960,Number(settings.width)))+'px');root.dataset.readingFocus=String(settings.focus);document.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-reading-setting]').forEach(el=>{const k=el.dataset.readingSetting as keyof typeof defaults;if(el instanceof HTMLInputElement&&el.type==='checkbox')el.checked=Boolean(settings[k]);else el.value=String(settings[k])});try{localStorage.setItem('garden-reading',JSON.stringify(settings))}catch{}document.dispatchEvent(new Event('garden:reading-focus-change'));if(save)document.dispatchEvent(new CustomEvent('garden:reading-settings',{detail:{...settings}}))}
document.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-reading-setting]').forEach(el=>el.addEventListener(el instanceof HTMLSelectElement?'change':'input',()=>{const k=el.dataset.readingSetting as keyof typeof defaults;(settings as any)[k]=el instanceof HTMLInputElement&&el.type==='checkbox'?el.checked:Number(el.value);apply(true)}));document.querySelector('[data-reading-reset]')?.addEventListener('click',()=>{settings={...defaults};apply(true)});apply();
document.addEventListener('garden:show-navigation',()=>{if(settings.focus){settings.focus=false;apply(true)}});
document.addEventListener('garden:preferences',event=>{const preferences=(event as CustomEvent<typeof defaults>).detail;settings={size:preferences.size,leading:preferences.leading,width:preferences.width,focus:preferences.focus};apply()});
document.addEventListener('garden:preference-save',event=>{const state=(event as CustomEvent<{state:string}>).detail.state;const status=document.querySelector<HTMLElement>('[data-reading-save-status]');if(status){status.textContent=state==='saving'?'در حال ذخیره در حساب…':state==='saved'?'در حساب ذخیره شد.':'ذخیره در حساب انجام نشد؛ تنظیمات فعلاً فقط روی این دستگاه است.';status.setAttribute('role',state==='error'?'alert':'status');}});
</script>
