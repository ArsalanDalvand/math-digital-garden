# ==========================================
# Math Digital Garden - Environment Config
# ==========================================

# --- General & Branding ---
SITE_URL=http://127.0.0.1:4321
PUBLIC_BRAND_NAME="باغ ریاضی"
PUBLIC_SITE_LANG=fa
PUBLIC_SITE_LANG_LABEL="فارسی"
PUBLIC_SITE_DIR=rtl

# --- Frontend & API Proxy ---
FRONTEND_ORIGIN=http://127.0.0.1:4321
EXTRA_ALLOWED_ORIGINS=
API_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/math_garden
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=math_garden
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/math_garden_test

# --- Markdown & Content Sync ---
CONTENT_GIT_REPO=

# --- Interactive Visualizations ---
# In production, optionally isolate GeoGebra viewer on a dedicated sandboxed domain
# PUBLIC_GEOGEBRA_VIEWER_ORIGIN=https://drawings.example.org

# --- AI & Study Assistant (Disabled by default until Phase 5 Hybrid Graph-RAG) ---
AI_ENABLED=false
DIFY_BASE_URL=http://127.0.0.1:5001/v1
DIFY_API_KEY=

# Direct LLM / Embeddings (Fallback when not using Dify)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
